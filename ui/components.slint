import { Theme } from "theme.slint";
import { CurrencyModel, CurrencyItem } from "models.slint";

export component PinDigitInput inherits Rectangle {
    in-out property <string> value: "";
    in property <bool> is-masked: false;
    out property <bool> has-focus: input.has-focus;
    
    callback filled();
    callback backspace-empty();
    callback focus-prev();
    callback focus-next();
    callback changed(string);
    callback accepted();

    forward-focus: input;

    public function activate() {
        input.focus();
        input.select-all();
    }

    public function clear() {
        root.value = "";
        input.text = "";
    }

    width: 38px;
    height: 42px;
    border-radius: 7px;
    background: input.has-focus ? Theme.primary-subtle : Theme.input-background;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.primary : (root.value != "" ? Theme.primary : Theme.input-border);

    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
            input.select-all();
        }
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.value != "" ? (root.is-masked ? "●" : root.value) : (input.has-focus ? "" : "·");
        color: root.value != "" ? Theme.text-primary : Theme.text-muted;
        font-size: root.value != "" ? (root.is-masked ? 14px : 16px) : 18px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    input := TextInput {
        opacity: 0;
        width: 100%;
        height: 100%;
        single-line: true;
        text: root.value;

        key-pressed(event) => {
            if event.text == Key.Backspace {
                if root.value != "" {
                    root.value = "";
                    input.text = "";
                    root.changed("");
                } else {
                    root.backspace-empty();
                }
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.focus-prev();
                return accept;
            }
            if event.text == Key.RightArrow {
                root.focus-next();
                return accept;
            }
            if event.text == Key.Return {
                root.accepted();
                return accept;
            }
            if event.text == "0" || event.text == "1" || event.text == "2" ||
               event.text == "3" || event.text == "4" || event.text == "5" ||
               event.text == "6" || event.text == "7" || event.text == "8" ||
               event.text == "9" {
                root.value = event.text;
                input.text = event.text;
                root.changed(event.text);
                root.filled();
                return accept;
            }
            if event.text == Key.Tab {
                return reject;
            }
            return accept;
        }
    }
}

export component SixDigitPinInput inherits Rectangle {
    out property <string> pin: d1.value + d2.value + d3.value + d4.value + d5.value + d6.value;
    out property <bool> is-complete: d1.value != "" && d2.value != "" && d3.value != "" && d4.value != "" && d5.value != "" && d6.value != "";
    in-out property <bool> is-masked: true;

    callback changed(string);
    callback complete(string);
    callback accepted(string);

    forward-focus: d1;

    public function clear() {
        d1.clear();
        d2.clear();
        d3.clear();
        d4.clear();
        d5.clear();
        d6.clear();
        d1.activate();
        root.changed("");
    }

    public function activate() {
        d1.activate();
    }

    HorizontalLayout {
        spacing: 6px;
        alignment: center;

        d1 := PinDigitInput {
            is-masked: root.is-masked;
            filled => {
                d2.activate();
                root.changed(root.pin);
            }
            focus-next => { d2.activate(); }
            accepted => { if root.is-complete { root.accepted(root.pin); } }
            changed(v) => { root.changed(root.pin); }
        }

        d2 := PinDigitInput {
            is-masked: root.is-masked;
            filled => {
                d3.activate();
                root.changed(root.pin);
            }
            backspace-empty => {
                d1.clear();
                d1.activate();
                root.changed(root.pin);
            }
            focus-prev => { d1.activate(); }
            focus-next => { d3.activate(); }
            accepted => { if root.is-complete { root.accepted(root.pin); } }
            changed(v) => { root.changed(root.pin); }
        }

        d3 := PinDigitInput {
            is-masked: root.is-masked;
            filled => {
                d4.activate();
                root.changed(root.pin);
            }
            backspace-empty => {
                d2.clear();
                d2.activate();
                root.changed(root.pin);
            }
            focus-prev => { d2.activate(); }
            focus-next => { d4.activate(); }
            accepted => { if root.is-complete { root.accepted(root.pin); } }
            changed(v) => { root.changed(root.pin); }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 2px;
                border-radius: 1px;
                background: Theme.border-strong;
            }
        }

        d4 := PinDigitInput {
            is-masked: root.is-masked;
            filled => {
                d5.activate();
                root.changed(root.pin);
            }
            backspace-empty => {
                d3.clear();
                d3.activate();
                root.changed(root.pin);
            }
            focus-prev => { d3.activate(); }
            focus-next => { d5.activate(); }
            accepted => { if root.is-complete { root.accepted(root.pin); } }
            changed(v) => { root.changed(root.pin); }
        }

        d5 := PinDigitInput {
            is-masked: root.is-masked;
            filled => {
                d6.activate();
                root.changed(root.pin);
            }
            backspace-empty => {
                d4.clear();
                d4.activate();
                root.changed(root.pin);
            }
            focus-prev => { d4.activate(); }
            focus-next => { d6.activate(); }
            accepted => { if root.is-complete { root.accepted(root.pin); } }
            changed(v) => { root.changed(root.pin); }
        }

        d6 := PinDigitInput {
            is-masked: root.is-masked;
            filled => {
                root.changed(root.pin);
                if root.is-complete {
                    root.complete(root.pin);
                }
            }
            backspace-empty => {
                d5.clear();
                d5.activate();
                root.changed(root.pin);
            }
            focus-prev => { d5.activate(); }
            accepted => { if root.is-complete { root.accepted(root.pin); } }
            changed(v) => {
                root.changed(root.pin);
                if root.is-complete {
                    root.complete(root.pin);
                }
            }
        }
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> badge-color: Theme.text-muted;
    in property <color> badge-bg: Theme.mode == 0 ? badge-color.transparentize(88%) : badge-color.transparentize(82%);

    background: badge-bg;
    border-radius: 4px;
    height: 22px;

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        alignment: center;
        Text {
            text: root.text;
            color: root.badge-color;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <color> btn-color: Theme.primary;
    in property <color> text-color: Colors.transparent;
    in property <bool> outline: false;
    in property <bool> small: false;
    in property <bool> enabled: true;
    callback clicked();

    opacity: enabled ? 1.0 : 0.5;
    background: !enabled ? (outline ? Colors.transparent : btn-color.transparentize(50%)) : (touch.pressed ? btn-color.darker(15%) : (touch.has-hover ? (outline ? btn-color.transparentize(85%) : btn-color.darker(6%)) : (outline ? Colors.transparent : btn-color)));
    border-color: outline ? (enabled ? btn-color : btn-color.transparentize(50%)) : Colors.transparent;
    border-width: outline ? 1px : 0px;
    border-radius: 6px;
    height: small ? 28px : 34px;

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: MouseCursor.pointer;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: small ? 10px : 14px;
        padding-right: small ? 10px : 14px;
        alignment: center;
        spacing: 6px;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: small ? 13px : 15px;
                height: small ? 13px : 15px;
                colorize: root.text-color != Colors.transparent ? root.text-color : (root.outline ? ((root.btn-color == Theme.surface-hover || root.btn-color == Theme.surface-subtle || root.btn-color == Theme.border || root.btn-color == Theme.border-strong) ? Theme.text-primary : root.btn-color) : ((root.btn-color == Theme.surface-hover || root.btn-color == Theme.surface-subtle) ? Theme.text-primary : #FFFFFF));
            }
        }

        if root.text != "": Text {
            text: root.text;
            color: root.text-color != Colors.transparent ? root.text-color : (root.outline ? ((root.btn-color == Theme.surface-hover || root.btn-color == Theme.surface-subtle || root.btn-color == Theme.border || root.btn-color == Theme.border-strong) ? Theme.text-primary : root.btn-color) : ((root.btn-color == Theme.surface-hover || root.btn-color == Theme.surface-subtle) ? Theme.text-primary : #FFFFFF));
            font-size: small ? 12px : 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component CloseButton inherits Rectangle {
    in property <bool> small: true;
    callback clicked();

    width: small ? 28px : 32px;
    height: small ? 28px : 32px;
    border-radius: 6px;
    background: touch.pressed ? Theme.surface-hover.darker(15%) : (touch.has-hover ? Theme.surface-hover : Colors.transparent);

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    Path {
        width: 10px;
        height: 10px;
        x: round((parent.width - self.width) / 2 / 1px) * 1px;
        y: round((parent.height - self.height) / 2 / 1px) * 1px;
        stroke: touch.has-hover ? Theme.text-primary : Theme.text-muted;
        stroke-width: 1.75px;

        MoveTo { x: 0; y: 0; }
        LineTo { x: 10; y: 10; }
        MoveTo { x: 10; y: 0; }
        LineTo { x: 0; y: 10; }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> btn-color: Theme.surface-subtle;
    in property <color> icon-color: Theme.text-primary;
    in property <bool> outline: false;
    in property <bool> small: true;
    in property <length> size: small ? 28px : 34px;
    in property <length> icon-size: small ? 14px : 16px;
    in property <bool> enabled: true;
    in property <string> tooltip: "";
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: 6px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: !root.enabled ? Colors.transparent : (touch.pressed ? (root.outline ? root.btn-color.transparentize(70%) : root.btn-color.darker(15%)) : (touch.has-hover ? (root.outline ? root.btn-color.transparentize(82%) : root.btn-color.darker(8%)) : (root.outline ? Colors.transparent : root.btn-color)));
    border-color: root.outline ? (touch.has-hover ? root.btn-color : root.btn-color.transparentize(40%)) : Theme.border;
    border-width: 1px;

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: MouseCursor.pointer;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: root.icon-size;
                height: root.icon-size;
                colorize: root.icon-color;
            }
        }
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> progress: 0.0; // 0.0 to 1.0 or greater
    in property <color> bar-color: progress > 1.0 ? Theme.danger : (progress > 0.85 ? Theme.warning : Theme.primary);

    height: 6px;
    border-radius: 3px;
    background: Theme.border;

    fill := Rectangle {
        x: 0;
        y: 0;
        height: parent.height;
        width: Math.min(parent.width, parent.width * Math.max(0.0, root.progress));
        border-radius: 3px;
        background: root.bar-color;
    }
}

export component StatCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> subtitle;
    in property <color> accent-color: Theme.primary;

    horizontal-stretch: 1;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 8px;

    VerticalLayout {
        padding: 13px;
        spacing: 3px;

        HorizontalLayout {
            Text {
                text: root.title;
                color: Theme.text-secondary;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 0.5px;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.value;
            color: Theme.text-primary;
            font-size: 22px;
            font-weight: 800;
            vertical-alignment: center;
        }

        if root.subtitle != "": Text {
            text: root.subtitle;
            color: root.accent-color;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    background: active ? Theme.primary-subtle : (touch.has-hover ? Theme.surface-hover : Colors.transparent);
    border-color: active ? Theme.primary : Theme.border;
    border-width: 1px;
    border-radius: 6px;
    height: 30px;

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.text;
            color: root.active ? Theme.primary : Theme.text-secondary;
            font-size: 12px;
            font-weight: root.active ? 700 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component AppInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text: "";
    in property <InputType> input-type: InputType.text;
    in property <bool> read-only <=> input.read-only;
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    in property <length> font-size: 13px;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <string> prefix-text: "";
    in property <color> focus-border-color: Theme.primary;

    callback accepted(string);
    callback edited(string);

    forward-focus: input;

    height: 36px;
    min-width: 40px;
    border-radius: 6px;
    background: Theme.input-background;
    border-width: 1px;
    border-color: input.has-focus ? root.focus-border-color : (touch.has-hover ? Theme.input-border-hover : Theme.input-border);

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;

        if root.prefix-text != "": VerticalLayout {
            alignment: center;
            Text {
                text: root.prefix-text;
                color: input.has-focus ? root.focus-border-color : Theme.text-muted;
                font-size: root.font-size;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        Rectangle {
            clip: true;

            if root.text == "" && root.placeholder-text != "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder-text;
                color: Theme.text-muted;
                font-size: root.font-size;
                vertical-alignment: center;
                horizontal-alignment: root.horizontal-alignment;
                overflow: elide;
            }

            input := TextInput {
                property <length> computed-x: 0px;

                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: 100%;
                vertical-alignment: center;
                horizontal-alignment: root.horizontal-alignment;
                single-line: true;
                color: Theme.text-primary;
                font-size: root.font-size;
                input-type: root.input-type;
                enabled: root.enabled;
                selection-background-color: root.focus-border-color.transparentize(70%);
                selection-foreground-color: Theme.text-primary;

                cursor-position-changed(cursor-position) => {
                    if cursor-position.x + self.computed-x < 0px {
                        self.computed-x = - cursor-position.x;
                    } else if cursor-position.x + self.computed-x > parent.width - self.text-cursor-width {
                        self.computed-x = parent.width - cursor-position.x - self.text-cursor-width;
                    }
                }

                accepted => {
                    root.accepted(self.text);
                }

                edited => {
                    root.edited(self.text);
                }
            }
        }
    }
}

export component AppTextEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text: "";
    in property <bool> read-only <=> input.read-only;
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    in property <length> font-size: 13px;
    in property <color> focus-border-color: Theme.primary;

    callback edited(string);

    forward-focus: input;

    min-height: 70px;
    border-radius: 6px;
    background: Theme.input-background;
    border-width: 1px;
    border-color: input.has-focus ? root.focus-border-color : (touch.has-hover ? Theme.input-border-hover : Theme.input-border);

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;

        Rectangle {
            clip: true;

            if root.text == "" && root.placeholder-text != "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder-text;
                color: Theme.text-muted;
                font-size: root.font-size;
                vertical-alignment: top;
                wrap: word-wrap;
            }

            input := TextInput {
                width: 100%;
                height: 100%;
                vertical-alignment: top;
                single-line: false;
                wrap: word-wrap;
                color: Theme.text-primary;
                font-size: root.font-size;
                enabled: root.enabled;
                selection-background-color: root.focus-border-color.transparentize(70%);
                selection-foreground-color: Theme.text-primary;

                edited => {
                    root.edited(self.text);
                }
            }
        }
    }
}

export component CurrencySelector inherits VerticalLayout {
    in-out property <string> selected-currency: "BDT";
    callback selected(string);

    spacing: 6px;

    HorizontalLayout {
        spacing: 6px;
        for curr in CurrencyModel.row-1: Rectangle {
            horizontal-stretch: 1;
            height: 34px;
            border-radius: 6px;
            background: root.selected-currency == curr.code ? Theme.primary : (touch1.has-hover ? Theme.surface-hover : Theme.input-background);
            border-color: root.selected-currency == curr.code ? Theme.primary : (touch1.has-hover ? Theme.border-strong : Theme.border);
            border-width: 1px;

            touch1 := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.selected-currency = curr.code;
                    root.selected(curr.code);
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 5px;
                padding-left: 6px;
                padding-right: 6px;

                Text {
                    text: curr.code;
                    font-size: 12px;
                    font-weight: root.selected-currency == curr.code ? 800 : 600;
                    color: root.selected-currency == curr.code ? #FFFFFF : Theme.text-primary;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        border-radius: 3px;
                        height: 18px;
                        background: root.selected-currency == curr.code ? #FFFFFF.transparentize(80%) : (Theme.mode == 0 ? #000000.transparentize(92%) : #FFFFFF.transparentize(90%));
                        VerticalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            alignment: center;
                            Text {
                                text: curr.symbol;
                                font-size: 11px;
                                font-weight: 700;
                                color: root.selected-currency == curr.code ? #FFFFFF : Theme.text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 6px;
        for curr in CurrencyModel.row-2: Rectangle {
            horizontal-stretch: 1;
            height: 34px;
            border-radius: 6px;
            background: root.selected-currency == curr.code ? Theme.primary : (touch2.has-hover ? Theme.surface-hover : Theme.input-background);
            border-color: root.selected-currency == curr.code ? Theme.primary : (touch2.has-hover ? Theme.border-strong : Theme.border);
            border-width: 1px;

            touch2 := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.selected-currency = curr.code;
                    root.selected(curr.code);
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 5px;
                padding-left: 6px;
                padding-right: 6px;

                Text {
                    text: curr.code;
                    font-size: 12px;
                    font-weight: root.selected-currency == curr.code ? 800 : 600;
                    color: root.selected-currency == curr.code ? #FFFFFF : Theme.text-primary;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        border-radius: 3px;
                        height: 18px;
                        background: root.selected-currency == curr.code ? #FFFFFF.transparentize(80%) : (Theme.mode == 0 ? #000000.transparentize(92%) : #FFFFFF.transparentize(90%));
                        VerticalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            alignment: center;
                            Text {
                                text: curr.symbol;
                                font-size: 11px;
                                font-weight: 700;
                                color: root.selected-currency == curr.code ? #FFFFFF : Theme.text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component ModernDatePickerPopup inherits PopupWindow {
    in property <int> selected-year: 2026;
    in property <int> selected-month: 10;
    in property <int> selected-day: 1;

    in property <int> today-year: 2026;
    in property <int> today-month: 10;
    in property <int> today-day: 1;

    in property <color> accent-color: Theme.primary;

    property <int> view-year: root.selected-year;
    property <int> view-month: root.selected-month;

    callback accepted(int, int, int);

    close-policy: close-on-click-outside;
    width: 280px;

    pure function is-leap(y: int) -> bool {
        (mod(y, 4) == 0 && mod(y, 100) != 0) || mod(y, 400) == 0
    }

    pure function get-days-in-month(m: int, y: int) -> int {
        if m == 2 {
            return is-leap(y) ? 29 : 28;
        }
        if m == 4 || m == 6 || m == 9 || m == 11 {
            return 30;
        }
        return 31;
    }

    pure function get-first-dow(m: int, y: int) -> int {
        mod(
            ((m < 3 ? y - 1 : y)
             + floor((m < 3 ? y - 1 : y) / 4)
             - floor((m < 3 ? y - 1 : y) / 100)
             + floor((m < 3 ? y - 1 : y) / 400)
             + (m == 1 ? 0 : (m == 2 ? 3 : (m == 3 ? 2 : (m == 4 ? 5 : (m == 5 ? 0 : (m == 6 ? 3 : (m == 7 ? 5 : (m == 8 ? 1 : (m == 9 ? 4 : (m == 10 ? 6 : (m == 11 ? 2 : 4)))))))))))
             + 1),
            7
        )
    }

    pure function get-month-name(m: int) -> string {
        if m == 1 { return "January"; }
        if m == 2 { return "February"; }
        if m == 3 { return "March"; }
        if m == 4 { return "April"; }
        if m == 5 { return "May"; }
        if m == 6 { return "June"; }
        if m == 7 { return "July"; }
        if m == 8 { return "August"; }
        if m == 9 { return "September"; }
        if m == 10 { return "October"; }
        if m == 11 { return "November"; }
        return "December";
    }

    pure function cell-day(i: int, first-dow: int, cur-days: int, prev-days: int) -> int {
        if i < first-dow {
            return prev-days - (first-dow - 1 - i);
        }
        if i >= first-dow + cur-days {
            return i - (first-dow + cur-days) + 1;
        }
        return i - first-dow + 1;
    }

    pure function cell-is-cur-month(i: int, first-dow: int, cur-days: int) -> bool {
        i >= first-dow && i < first-dow + cur-days
    }

    pure function cell-month(i: int, first-dow: int, cur-days: int, cur-m: int) -> int {
        if i < first-dow {
            return cur-m == 1 ? 12 : cur-m - 1;
        }
        if i >= first-dow + cur-days {
            return cur-m == 12 ? 1 : cur-m + 1;
        }
        return cur-m;
    }

    pure function cell-year(i: int, first-dow: int, cur-days: int, cur-m: int, cur-y: int) -> int {
        if i < first-dow {
            return cur-m == 1 ? cur-y - 1 : cur-y;
        }
        if i >= first-dow + cur-days {
            return cur-m == 12 ? cur-y + 1 : cur-y;
        }
        return cur-y;
    }

    Rectangle {
        background: Theme.surface;
        border-color: Theme.border-strong;
        border-width: 1px;
        border-radius: 10px;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            // Month Navigation Header
            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.get-month-name(root.view-month) + " " + root.view-year;
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;

                    // Today quick jump pill
                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: today-touch.has-hover ? Theme.surface-hover : Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;

                        today-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.accepted(root.today-year, root.today-month, root.today-day);
                                root.close();
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            Text {
                                text: "Today";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Prev Month
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: prev-touch.has-hover ? Theme.surface-hover : Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;

                        prev-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                if root.view-month == 1 {
                                    root.view-month = 12;
                                    root.view-year = root.view-year - 1;
                                } else {
                                    root.view-month = root.view-month - 1;
                                }
                            }
                        }

                        Text {
                            text: "‹";
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Next Month
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: next-touch.has-hover ? Theme.surface-hover : Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;

                        next-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                if root.view-month == 12 {
                                    root.view-month = 1;
                                    root.view-year = root.view-year + 1;
                                } else {
                                    root.view-month = root.view-month + 1;
                                }
                            }
                        }

                        Text {
                            text: "›";
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Weekday Row
            HorizontalLayout {
                spacing: 2px;
                for day-name in ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"]: Rectangle {
                    horizontal-stretch: 1;
                    height: 20px;
                    Text {
                        text: day-name;
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // 42-day Calendar Grid
            GridLayout {
                spacing: 2px;
                for i in 42: Rectangle {
                    row: floor(i / 7);
                    col: mod(i, 7);
                    height: 28px;
                    border-radius: 5px;

                    property <int> first-dow: root.get-first-dow(root.view-month, root.view-year);
                    property <int> cur-days: root.get-days-in-month(root.view-month, root.view-year);
                    property <int> prev-m: root.view-month == 1 ? 12 : root.view-month - 1;
                    property <int> prev-y: root.view-month == 1 ? root.view-year - 1 : root.view-year;
                    property <int> prev-days: root.get-days-in-month(prev-m, prev-y);

                    property <int> d-num: root.cell-day(i, first-dow, cur-days, prev-days);
                    property <bool> is-cur: root.cell-is-cur-month(i, first-dow, cur-days);
                    property <int> tgt-m: root.cell-month(i, first-dow, cur-days, root.view-month);
                    property <int> tgt-y: root.cell-year(i, first-dow, cur-days, root.view-month, root.view-year);

                    property <bool> is-selected: tgt-y == root.selected-year && tgt-m == root.selected-month && d-num == root.selected-day;
                    property <bool> is-today: tgt-y == root.today-year && tgt-m == root.today-month && d-num == root.today-day;

                    background: is-selected ? root.accent-color : (cell-touch.has-hover ? Theme.surface-hover : #000000.transparentize(100%));
                    border-color: is-today && !is-selected ? root.accent-color : #000000.transparentize(100%);
                    border-width: is-today && !is-selected ? 1.5px : 0px;

                    cell-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.accepted(tgt-y, tgt-m, d-num);
                            root.close();
                        }
                    }

                    Text {
                        text: d-num;
                        color: is-selected ? #FFFFFF : (is-cur ? Theme.text-primary : Theme.text-muted.transparentize(50%));
                        font-size: 12px;
                        font-weight: is-selected || is-today ? 700 : 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component ModernTimePickerPopup inherits PopupWindow {
    in property <int> selected-hour: 12;
    in property <int> selected-minute: 0;

    in property <int> today-hour: 12;
    in property <int> today-minute: 0;

    in property <color> accent-color: Theme.primary;

    property <int> current-hour: root.selected-hour;
    property <int> current-minute: root.selected-minute;

    callback accepted(int, int);

    close-policy: close-on-click-outside;
    width: 260px;

    pure function pad(n: int) -> string {
        n < 10 ? ("0" + n) : ("" + n)
    }

    Rectangle {
        background: Theme.surface;
        border-color: Theme.border-strong;
        border-width: 1px;
        border-radius: 10px;
        clip: true;

        VerticalLayout {
            padding: 14px;
            spacing: 12px;

            // Header
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Select Time";
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                }

                // "Now" quick jump pill
                Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: now-touch.has-hover ? Theme.surface-hover : Theme.surface-subtle;
                    border-width: 1px;
                    border-color: Theme.border;

                    now-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.current-hour = root.today-hour;
                            root.current-minute = root.today-minute;
                            root.accepted(root.today-hour, root.today-minute);
                            root.close();
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Text {
                            text: "Now";
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Steppers & Digital Time Hero
            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                // Hour Column
                VerticalLayout {
                    spacing: 4px;
                    alignment: center;

                    // Hour Up
                    Rectangle {
                        width: 56px;
                        height: 24px;
                        border-radius: 4px;
                        background: h-up-touch.has-hover ? Theme.surface-hover : Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;

                        h-up-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.current-hour = root.current-hour >= 23 ? 0 : root.current-hour + 1;
                            }
                        }

                        Text {
                            text: "▲";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Hour Value
                    Rectangle {
                        width: 56px;
                        height: 42px;
                        border-radius: 6px;
                        background: Theme.input-background;
                        border-width: 1px;
                        border-color: Theme.input-border;

                        Text {
                            text: root.pad(root.current-hour);
                            font-size: 22px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Hour Down
                    Rectangle {
                        width: 56px;
                        height: 24px;
                        border-radius: 4px;
                        background: h-dn-touch.has-hover ? Theme.surface-hover : Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;

                        h-dn-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.current-hour = root.current-hour <= 0 ? 23 : root.current-hour - 1;
                            }
                        }

                        Text {
                            text: "▼";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Colon Separator
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: ":";
                        font-size: 22px;
                        font-weight: 700;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Minute Column
                VerticalLayout {
                    spacing: 4px;
                    alignment: center;

                    // Minute Up
                    Rectangle {
                        width: 56px;
                        height: 24px;
                        border-radius: 4px;
                        background: m-up-touch.has-hover ? Theme.surface-hover : Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;

                        m-up-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.current-minute = root.current-minute >= 59 ? 0 : root.current-minute + 1;
                            }
                        }

                        Text {
                            text: "▲";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Minute Value
                    Rectangle {
                        width: 56px;
                        height: 42px;
                        border-radius: 6px;
                        background: Theme.input-background;
                        border-width: 1px;
                        border-color: Theme.input-border;

                        Text {
                            text: root.pad(root.current-minute);
                            font-size: 22px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Minute Down
                    Rectangle {
                        width: 56px;
                        height: 24px;
                        border-radius: 4px;
                        background: m-dn-touch.has-hover ? Theme.surface-hover : Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;

                        m-dn-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.current-minute = root.current-minute <= 0 ? 59 : root.current-minute - 1;
                            }
                        }

                        Text {
                            text: "▼";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Quick Minute Snaps
            HorizontalLayout {
                spacing: 4px;
                for snap-min in [0, 15, 30, 45]: Rectangle {
                    horizontal-stretch: 1;
                    height: 26px;
                    border-radius: 4px;
                    background: root.current-minute == snap-min ? root.accent-color : (snap-touch.has-hover ? Theme.surface-hover : Theme.surface-subtle);
                    border-width: 1px;
                    border-color: root.current-minute == snap-min ? root.accent-color : Theme.border;

                    snap-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.current-minute = snap-min;
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: ":" + (snap-min < 10 ? "0" : "") + snap-min;
                            font-size: 11px;
                            font-weight: root.current-minute == snap-min ? 700 : 500;
                            color: root.current-minute == snap-min ? #FFFFFF : Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Action Buttons
            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                Rectangle {
                    width: 66px;
                    height: 28px;
                    border-radius: 5px;
                    background: cancel-touch.has-hover ? Theme.surface-hover : Theme.surface-subtle;
                    border-width: 1px;
                    border-color: Theme.border;

                    cancel-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.close();
                        }
                    }

                    Text {
                        text: "Cancel";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 82px;
                    height: 28px;
                    border-radius: 5px;
                    background: root.accent-color;

                    set-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.accepted(root.current-hour, root.current-minute);
                            root.close();
                        }
                    }

                    Text {
                        text: "Set Time";
                        font-size: 11px;
                        font-weight: 700;
                        color: #FFFFFF;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

