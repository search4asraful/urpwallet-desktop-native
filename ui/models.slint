export struct CurrencyItem {
    code: string,
    label: string,
}

export global CurrencyModel {
    out property <[CurrencyItem]> row-1: [
        { code: "BDT", label: "BDT (৳)" },
        { code: "USD", label: "USD ($)" },
        { code: "EUR", label: "EUR (€)" },
        { code: "GBP", label: "GBP (£)" },
    ];
    out property <[CurrencyItem]> row-2: [
        { code: "INR", label: "INR (₹)" },
        { code: "CAD", label: "CAD (CA$)" },
        { code: "AUD", label: "AUD (AU$)" },
        { code: "JPY", label: "JPY (¥)" },
    ];
}

export struct AccountItem {
    id: string,
    name: string,
    acc_type: string,
    currency: string,
    balance: string,
    color: string,
    is_liability: bool,
}

export struct TransactionItem {
    id: string,
    date: string,
    time: string,
    title: string,
    subtitle: string,
    amount: string,
    raw_amount: string,
    is_income: bool,
    is_transfer: bool,
    color: string,
    account_id: string,
    account_name: string,
    to_account_id: string,
    to_account_name: string,
    category_id: string,
    category_name: string,
    payee: string,
    note: string,
    payment_type: string,
    status: string,
}

