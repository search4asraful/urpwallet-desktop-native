export struct CurrencyItem {
    code: string,
    label: string,
    symbol: string,
}

export global CurrencyModel {
    out property <[CurrencyItem]> row-1: [
        { code: "BDT", label: "BDT", symbol: "৳" },
        { code: "USD", label: "USD", symbol: "$" },
        { code: "EUR", label: "EUR", symbol: "€" },
        { code: "GBP", label: "GBP", symbol: "£" },
    ];
    out property <[CurrencyItem]> row-2: [
        { code: "INR", label: "INR", symbol: "₹" },
        { code: "CAD", label: "CAD", symbol: "CA$" },
        { code: "AUD", label: "AUD", symbol: "AU$" },
        { code: "JPY", label: "JPY", symbol: "¥" },
    ];

    pure public function get-symbol(code: string) -> string {
        if code == "BDT" { return "৳"; }
        if code == "USD" { return "$"; }
        if code == "EUR" { return "€"; }
        if code == "GBP" { return "£"; }
        if code == "INR" { return "₹"; }
        if code == "CAD" { return "CA$"; }
        if code == "AUD" { return "A$"; }
        if code == "JPY" { return "¥"; }
        if code == "CHF" { return "CHF"; }
        if code == "CNY" { return "¥"; }
        return "$";
    }
}

