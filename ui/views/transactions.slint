import { Theme } from "../theme.slint";
import { TransactionItem } from "../models.slint";
import { Badge, AppButton, TabButton, AppInput } from "../components.slint";
import { ScrollView } from "std-widgets.slint";

export component TransactionsView inherits VerticalLayout {
    spacing: 8px;

    in property <string> tx-search-query: "";
    in property <int> tx-filter-type: 0;
    in property <[TransactionItem]> all-transactions: [];
    in property <int> selected-tx-count: 0;

    property <bool> confirm-bulk-delete: false;

    callback search-transactions(string, int);
    callback open-add-tx(int);
    callback open-tx-details(string);
    callback open-edit-tx(string);
    callback delete-transaction(string);
    callback toggle-tx-selection(string);
    callback select-all-txs(bool);
    callback clear-tx-selection();
    callback bulk-delete-selected();

    // Search & Filters Bar
    HorizontalLayout {
        spacing: 8px;
        height: 36px;

        search-edit := AppInput {
            placeholder-text: "Search by payee, category, note...";
            font-size: 13px;
            text: root.tx-search-query;
            edited => { root.search-transactions(self.text, root.tx-filter-type); }
            accepted => { root.search-transactions(self.text, root.tx-filter-type); }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 5px;
                TabButton {
                    text: "All";
                    active: root.tx-filter-type == 0;
                    clicked => { root.search-transactions(search-edit.text, 0); }
                }
                TabButton {
                    text: "Expenses";
                    active: root.tx-filter-type == 1;
                    clicked => { root.search-transactions(search-edit.text, 1); }
                }
                TabButton {
                    text: "Income";
                    active: root.tx-filter-type == 2;
                    clicked => { root.search-transactions(search-edit.text, 2); }
                }
                TabButton {
                    text: "Transfers";
                    active: root.tx-filter-type == 3;
                    clicked => { root.search-transactions(search-edit.text, 3); }
                }
            }
        }
    }

    // Actions & Selection Toolbar Row
    if root.all-transactions.length > 0: Rectangle {
        height: 40px;
        background: root.selected-tx-count > 0 ? Theme.primary.transparentize(90%) : Theme.surface;
        border-color: root.selected-tx-count > 0 ? Theme.primary.transparentize(50%) : Theme.border;
        border-width: 1px;
        border-radius: 6px;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            alignment: space-between;

            HorizontalLayout {
                alignment: center;
                spacing: 10px;

                // Master Checkbox (Vertically Centered)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        background: root.selected-tx-count > 0 ? Theme.primary : Theme.surface-subtle;
                        border-color: root.selected-tx-count > 0 ? Theme.primary : (master-chk-touch.has-hover ? Theme.primary : Theme.border-strong);
                        border-width: 1.5px;

                        master-chk-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.confirm-bulk-delete = false;
                                if root.selected-tx-count > 0 {
                                    root.clear-tx-selection();
                                } else {
                                    root.select-all-txs(true);
                                }
                            }
                        }

                        if root.selected-tx-count > 0: Path {
                            width: 10px;
                            height: 10px;
                            x: 4px;
                            y: 4px;
                            stroke: #FFFFFF;
                            stroke-width: 2px;
                            MoveTo { x: 1; y: 5; }
                            LineTo { x: 4; y: 8; }
                            LineTo { x: 9; y: 2; }
                        }
                    }
                }

                if root.selected-tx-count == 0: Text {
                    text: "" + root.all-transactions.length + (root.all-transactions.length == 1 ? " transaction" : " transactions");
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }

                if root.selected-tx-count > 0: Text {
                    text: "" + root.selected-tx-count + (root.selected-tx-count == 1 ? " transaction selected" : " transactions selected");
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.primary;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 8px;

                    if root.selected-tx-count == 0: AppButton {
                        text: "Select All";
                        small: true;
                        outline: true;
                        btn-color: Theme.border;
                        text-color: Theme.text-secondary;
                        clicked => { root.select-all-txs(true); }
                    }
                    
                    if root.selected-tx-count > 0: TouchArea {
                        width: 95px;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.confirm-bulk-delete = false;
                            root.clear-tx-selection();
                        }
                        Text {
                            text: "Clear Selection";
                            font-size: 12px;
                            font-weight: 600;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    if root.selected-tx-count > 0 && !root.confirm-bulk-delete && root.selected-tx-count < root.all-transactions.length: AppButton {
                        text: "Select All (" + root.all-transactions.length + ")";
                        small: true;
                        outline: true;
                        btn-color: Theme.primary;
                        clicked => { root.select-all-txs(true); }
                    }

                    if root.selected-tx-count > 0 && !root.confirm-bulk-delete: AppButton {
                        text: "Delete Selected (" + root.selected-tx-count + ")";
                        small: true;
                        btn-color: Theme.danger;
                        clicked => { root.confirm-bulk-delete = true; }
                    }

                    if root.selected-tx-count > 0 && root.confirm-bulk-delete: HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "Permanently delete " + root.selected-tx-count + " transactions?";
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.danger;
                            vertical-alignment: center;
                        }

                        AppButton {
                            text: "Confirm Delete";
                            small: true;
                            btn-color: Theme.danger;
                            clicked => {
                                root.confirm-bulk-delete = false;
                                root.bulk-delete-selected();
                            }
                        }

                        AppButton {
                            text: "Cancel";
                            small: true;
                            outline: true;
                            btn-color: Theme.border;
                            text-color: Theme.text-primary;
                            clicked => {
                                root.confirm-bulk-delete = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // Transactions Full Ledger List
    ScrollView {
        VerticalLayout {
            spacing: 5px;

            if root.all-transactions.length == 0: Rectangle {
                height: 100px;
                background: Theme.surface;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 6px;
                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    Text { text: "No Transactions Found"; font-size: 15px; font-weight: 700; color: Theme.text-primary; horizontal-alignment: center; }
                    Text { text: "Adjust search filter or click '+ New Entry' to record a transaction."; font-size: 12px; color: Theme.text-muted; horizontal-alignment: center; }
                }
            }

            for tx in root.all-transactions: Rectangle {
                height: 56px;
                background: tx.selected ? Theme.primary-subtle : Theme.surface;
                border-color: tx.selected ? Theme.primary : Theme.border;
                border-width: 1px;
                border-radius: 6px;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 12px;

                        // Checkbox (Vertically Centered)
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 4px;
                                background: tx.selected ? Theme.primary : Theme.surface-subtle;
                                border-color: tx.selected ? Theme.primary : (chk-touch.has-hover ? Theme.primary : Theme.border-strong);
                                border-width: 1.5px;

                                chk-touch := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.confirm-bulk-delete = false;
                                        root.toggle-tx-selection(tx.id);
                                    }
                                }

                                if tx.selected: Path {
                                    width: 10px;
                                    height: 10px;
                                    x: 4px;
                                    y: 4px;
                                    stroke: #FFFFFF;
                                    stroke-width: 2px;
                                    MoveTo { x: 1; y: 5; }
                                    LineTo { x: 4; y: 8; }
                                    LineTo { x: 9; y: 2; }
                                }
                            }
                        }

                        Text {
                            text: tx.date;
                            color: Theme.text-muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: tx.title;
                                color: Theme.text-primary;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                Badge {
                                    text: tx.is_transfer ? (tx.account_name + " → " + tx.to_account_name) : tx.account_name;
                                    badge-color: Theme.info;
                                }
                                if tx.category_name != "": Badge {
                                    text: tx.category_name;
                                    badge-color: Theme.accent;
                                }
                                if tx.note != "": Text {
                                    text: tx.note;
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                width: 105px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                text: tx.amount;
                                color: tx.is_transfer ? Theme.info : (tx.is_income ? Theme.primary : Theme.danger);
                                font-size: 14px;
                                font-weight: 700;
                            }
                            AppButton {
                                width: 58px;
                                text: "Details";
                                small: true;
                                outline: true;
                                btn-color: Theme.info;
                                clicked => { root.open-tx-details(tx.id); }
                            }
                            AppButton {
                                width: 50px;
                                text: "Edit";
                                small: true;
                                outline: true;
                                btn-color: Theme.primary;
                                clicked => { root.open-edit-tx(tx.id); }
                            }
                            AppButton {
                                width: 58px;
                                text: "Delete";
                                small: true;
                                outline: true;
                                btn-color: Theme.danger;
                                clicked => { root.delete-transaction(tx.id); }
                            }
                        }
                    }
                }
            }
        }
    }
}
