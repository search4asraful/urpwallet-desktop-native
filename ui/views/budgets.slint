import { Theme } from "../theme.slint";
import { BudgetItem } from "../models.slint";
import { AppButton, Badge, ProgressBar, IconButton } from "../components.slint";
import { ScrollView } from "std-widgets.slint";

export component BudgetsView inherits ScrollView {
    in property <string> safe-to-spend: "$0.00";
    in property <int> safe-days-left: 1;
    in property <[BudgetItem]> budgets: [];

    callback open-new-budget();
    callback select-budget(BudgetItem);
    callback open-edit-budget(string);
    callback request-delete-budget(string, string, string);

    VerticalLayout {
        spacing: 10px;

        // Safe-to-Spend Formula Banner
        Rectangle {
            height: 110px;
            background: Theme.surface;
            border-color: Theme.primary;
            border-width: 1px;
            border-radius: 8px;

            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 4px;
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "DYNAMIC DAILY SAFE-TO-SPEND";
                            color: Theme.primary;
                            font-size: 11px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.safe-to-spend + " / day";
                            color: Theme.text-primary;
                            font-size: 22px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Formula: (Total Remaining Discretionary Budget) ÷ (" + root.safe-days-left + " Days Left in Month)";
                            color: Theme.text-muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        AppButton {
                            text: "+ New Budget Limit";
                            small: true;
                            btn-color: Theme.primary;
                            clicked => { root.open-new-budget(); }
                        }
                    }
                }
            }
        }

        if root.budgets.length == 0: Rectangle {
            height: 100px;
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 6px;
            VerticalLayout {
                alignment: center;
                spacing: 5px;
                Text { text: "No Budgets Configured"; font-size: 15px; font-weight: 700; color: Theme.text-primary; horizontal-alignment: center; }
                Text { text: "Click '+ New Budget Limit' to establish category spending ceilings."; font-size: 12px; color: Theme.text-muted; horizontal-alignment: center; }
            }
        }

        // Budget Items Grid
        for b in root.budgets: Rectangle {
            height: 100px;
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: b.name;
                                color: Theme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                width: 95px;
                                Badge {
                                    text: b.is_over ? "OVER BUDGET" : "ON TRACK";
                                    badge-color: b.is_over ? Theme.danger : Theme.primary;
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                width: 55px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                text: Math.round(b.percentage) + "%";
                                color: b.is_over ? Theme.danger : Theme.text-primary;
                                font-size: 14px;
                                font-weight: 800;
                            }
                            IconButton {
                                icon: @image-url("../../assets/icons/eye.svg");
                                outline: true;
                                btn-color: Theme.info;
                                icon-color: Theme.info;
                                tooltip: "View Details";
                                clicked => {
                                    root.select-budget(b);
                                }
                            }
                            IconButton {
                                icon: @image-url("../../assets/icons/pen-edit.svg");
                                outline: true;
                                btn-color: Theme.primary;
                                icon-color: Theme.primary;
                                tooltip: "Edit";
                                clicked => { root.open-edit-budget(b.id); }
                            }
                            IconButton {
                                icon: @image-url("../../assets/icons/trash.svg");
                                outline: true;
                                btn-color: Theme.danger;
                                icon-color: Theme.danger;
                                tooltip: "Delete";
                                clicked => {
                                    root.request-delete-budget(
                                        b.id,
                                        b.name,
                                        "Monthly Limit: " + b.total
                                    );
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Spent: " + b.spent + " of " + b.total + " • Safe pacing: " + b.daily_safe + "/day \nCategories: " + (b.category_name != "" ? b.category_name : "All");
                        color: Theme.text-secondary;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                ProgressBar {
                    progress: b.percentage / 100.0;
                }
            }
        }
    }
}
