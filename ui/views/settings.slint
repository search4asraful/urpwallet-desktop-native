import { Theme } from "../theme.slint";
import { CategoryItem } from "../models.slint";
import { Badge, AppButton, TabButton, AppInput, SixDigitPinInput, CurrencySelector } from "../components.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";

export component SettingsView inherits ScrollView {
    in property <string> settings-status-msg: "";
    in property <bool> pin-protected: false;
    in property <string> base-currency: "BDT";
    in-out property <bool> privacy-mode: false;
    in property <string> date-format: "YYYY-MM-DD";
    in property <[CategoryItem]> categories: [];
    in property <[CategoryItem]> filtered-categories: [];
    in property <int> cat-expense-count: 0;
    in property <int> cat-income-count: 0;
    in-out property <int> cat-catalog-filter: 0;
    in-out property <string> cat-search-query: "";
    in-out property <bool> show-add-cat-form: false;
    in-out property <string> editing-cat-id: "";
    in-out property <string> new-cat-name: "";
    in-out property <int> new-cat-type: 0;
    in-out property <string> new-cat-color: "#10B981";
    in property <string> db-storage-path: "";
    in property <string> export-storage-path: "";

    in-out property <bool> pin-masked: true;
    in property <bool> gdrive-connected: false;
    in property <string> gdrive-email: "";
    in property <string> gdrive-frequency: "daily";
    in property <string> gdrive-last-backup: "";

    callback select-db-file();
    callback reset-default-db();
    callback select-export-folder();
    callback open-export-folder();

    callback set-master-pin(string);
    callback disable-master-pin(string);
    callback set-theme(int);
    callback update-base-currency(string);
    callback toggle-privacy();
    callback update-date-format(string);
    callback filter-categories(int);
    callback search-categories(string);
    callback add-category(string, int, string);
    callback edit-category(string, string, int, string);
    callback delete-category(string);
    callback export-data(string);
    callback import-backup();
    callback reset-and-seed-demo();
    callback open-gdrive-modal();
    callback gdrive-backup-now();
    callback gdrive-disconnect();

    VerticalLayout {
        padding-top: 8px;
        padding-bottom: 20px;
        spacing: 14px;

        // STATUS MESSAGE BANNER (if present)
        if root.settings-status-msg != "": Rectangle {
            background: Theme.primary-subtle;
            border-color: Theme.primary;
            border-width: 1px;
            border-radius: 8px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 9px;
                padding-bottom: 9px;
                spacing: 10px;
                alignment: start;

                Badge {
                    text: "Notification";
                    badge-color: Theme.primary;
                }

                Text {
                    text: root.settings-status-msg;
                    color: Theme.text-primary;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        // SECTION 1: MASTER PIN / PASSPHRASE SECURITY
        Rectangle {
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 10px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // Header with normalized badges
                HorizontalLayout {
                    alignment: space-between;
                    spacing: 12px;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Master PIN / Passphrase Security";
                            color: Theme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Cryptographic protection powered by Argon2 key derivation. Auto-locks wallet on application launch.";
                            color: Theme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 6px;

                        Badge {
                            text: "Argon2id";
                            badge-color: Theme.purple;
                        }

                        Badge {
                            text: root.pin-protected ? "Protected" : "Unprotected";
                            badge-color: root.pin-protected ? Theme.primary : Theme.warning;
                        }
                    }
                }

                // Consolidated Single Horizontal Panel
                Rectangle {
                    background: Theme.surface-subtle;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 8px;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 14px;
                        alignment: space-between;

                        // Left: Instruction text with two compact utility buttons below
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 6px;

                            Text {
                                text: root.pin-protected ? "Enter 6-digit PIN to update security or remove protection:" : "Set a 6-digit master PIN to lock your finances on startup:";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                AppButton {
                                    text: root.pin-masked ? "Show PIN" : "Hide PIN";
                                    small: true;
                                    outline: true;
                                    btn-color: Theme.border-strong;
                                    clicked => {
                                        root.pin-masked = !root.pin-masked;
                                    }
                                }

                                AppButton {
                                    text: "Clear";
                                    small: true;
                                    outline: true;
                                    btn-color: Theme.border-strong;
                                    clicked => {
                                        pin-set-edit.clear();
                                    }
                                }
                            }
                        }

                        // Center: 6 distinct digit boxes formatted as [•][•][•] - [•][•][•]
                        VerticalLayout {
                            alignment: center;

                            pin-set-edit := SixDigitPinInput {
                                is-masked <=> root.pin-masked;
                                accepted(pin_val) => {
                                    if self.is-complete {
                                        root.set-master-pin(pin_val);
                                        self.clear();
                                    }
                                }
                            }
                        }

                        // Right: Primary action button Enable 6-Digit PIN (disabled until all 6 digits are provided)
                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;

                            AppButton {
                                text: root.pin-protected ? "Update PIN" : "Enable 6-Digit PIN";
                                small: false;
                                btn-color: Theme.primary;
                                enabled: pin-set-edit.is-complete;
                                clicked => {
                                    if pin-set-edit.is-complete {
                                        root.set-master-pin(pin-set-edit.pin);
                                        pin-set-edit.clear();
                                    }
                                }
                            }

                            if root.pin-protected: AppButton {
                                text: "Disable Protection";
                                small: true;
                                outline: true;
                                btn-color: Theme.danger;
                                enabled: pin-set-edit.is-complete;
                                clicked => {
                                    if pin-set-edit.is-complete {
                                        root.disable-master-pin(pin-set-edit.pin);
                                        pin-set-edit.clear();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // SECTION 2: THEME & VISUAL APPEARANCE
        Rectangle {
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 10px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Theme & Visual Appearance";
                            color: Theme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Select your preferred visual style or contrast balance across the application";
                            color: Theme.text-muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    Badge {
                        text: Theme.mode == 0 ? "Clean Light" : (Theme.mode == 1 ? "Dark Obsidian" : (Theme.mode == 2 ? "Midnight OLED" : "Emerald Forest"));
                        badge-color: Theme.primary;
                    }
                }

                // 4 Theme Cards: 4-column balanced grid spanning full row (horizontal-stretch: 1, gap: 12px)
                HorizontalLayout {
                    spacing: 12px;

                    for th_item in [
                        { name: "Clean Light", desc: "Crisp slate & pure surfaces", mode: 0, bg: #F4F5F8, card: #FFFFFF, acc: #10B981 },
                        { name: "Dark Obsidian", desc: "Deep obsidian & emerald glow", mode: 1, bg: #090A0F, card: #12151C, acc: #10B981 },
                        { name: "Midnight OLED", desc: "Pure #000000 for OLED panels", mode: 2, bg: #000000, card: #09090B, acc: #10B981 },
                        { name: "Emerald Forest", desc: "Finance forest & mint accents", mode: 3, bg: #06110D, card: #0B1A14, acc: #34D399 },
                    ]: Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: Theme.mode == th_item.mode ? Theme.primary-subtle : Theme.surface-subtle;
                        border-color: Theme.mode == th_item.mode ? Theme.primary : Theme.border;
                        border-width: Theme.mode == th_item.mode ? 2px : 1px;

                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                Theme.mode = th_item.mode;
                                root.set-theme(th_item.mode);
                            }
                        }

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            // Title & Active Badge
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: th_item.name;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }
                                if Theme.mode == th_item.mode: Badge {
                                    text: "Active";
                                    badge-color: Theme.primary;
                                }
                            }

                            Text {
                                text: th_item.desc;
                                font-size: 11px;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }

                            // Miniature UI Mockup: mini sidebar, card rectangle, and theme accent bar
                            Rectangle {
                                height: 46px;
                                background: th_item.bg;
                                border-radius: 5px;
                                border-width: 1px;
                                border-color: Theme.mode == th_item.mode ? th_item.acc.transparentize(60%) : Theme.border;
                                clip: true;

                                HorizontalLayout {
                                    padding: 3px;
                                    spacing: 3px;

                                    // Mini sidebar
                                    Rectangle {
                                        width: 13px;
                                        background: th_item.card;
                                        border-radius: 2px;
                                        border-width: 0.5px;
                                        border-color: Theme.border.transparentize(60%);

                                        VerticalLayout {
                                            padding: 2px;
                                            spacing: 3px;
                                            alignment: start;

                                            // Mini logo dot
                                            Rectangle {
                                                width: 5px;
                                                height: 5px;
                                                border-radius: 2.5px;
                                                background: th_item.acc;
                                            }
                                            // Mini nav items
                                            Rectangle {
                                                width: 7px;
                                                height: 2px;
                                                border-radius: 1px;
                                                background: th_item.acc;
                                            }
                                            Rectangle {
                                                width: 6px;
                                                height: 2px;
                                                border-radius: 1px;
                                                background: Theme.text-muted.transparentize(70%);
                                            }
                                            Rectangle {
                                                width: 6px;
                                                height: 2px;
                                                border-radius: 1px;
                                                background: Theme.text-muted.transparentize(70%);
                                            }
                                        }
                                    }

                                    // Mini content area
                                    VerticalLayout {
                                        spacing: 3px;
                                        horizontal-stretch: 1;

                                        // Theme accent bar
                                        Rectangle {
                                            height: 3px;
                                            border-radius: 1.5px;
                                            background: th_item.acc;
                                        }

                                        // Mini card rectangle
                                        Rectangle {
                                            vertical-stretch: 1;
                                            background: th_item.card;
                                            border-radius: 3px;
                                            border-width: 0.5px;
                                            border-color: Theme.border.transparentize(50%);

                                            VerticalLayout {
                                                padding: 3px;
                                                spacing: 2px;
                                                alignment: center;

                                                Rectangle {
                                                    width: 40%;
                                                    height: 2px;
                                                    border-radius: 1px;
                                                    background: Theme.text-muted.transparentize(60%);
                                                }
                                                Rectangle {
                                                    width: 65%;
                                                    height: 3px;
                                                    border-radius: 1.5px;
                                                    background: th_item.acc.transparentize(40%);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // SECTION 3: DISPLAY & REGIONAL PREFERENCES
        Rectangle {
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 10px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Display & Regional Preferences";
                            color: Theme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Unified currency chips, calendar date presentation, and balance privacy masking";
                            color: Theme.text-muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    // Base Currency Card
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface-subtle;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 8px;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Base Currency";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }
                                Badge {
                                    text: root.base-currency;
                                    badge-color: Theme.primary;
                                }
                            }

                            CurrencySelector {
                                selected-currency: root.base-currency;
                                selected(code) => {
                                    root.update-base-currency(code);
                                }
                            }
                        }
                    }

                    // Date Presentation Format & Balance Privacy Mode Card
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface-subtle;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 8px;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 12px;

                            // Date Format Segmented Control
                            VerticalLayout {
                                spacing: 8px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Date Presentation Format";
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                    Badge {
                                        text: root.date-format;
                                        badge-color: Theme.primary;
                                    }
                                }

                                // Segmented Control Bar
                                Rectangle {
                                    height: 34px;
                                    border-radius: 6px;
                                    background: Theme.input-background;
                                    border-color: Theme.border;
                                    border-width: 1px;

                                    HorizontalLayout {
                                        padding: 2px;
                                        spacing: 2px;

                                        for fmt_item in [
                                            { fmt: "YYYY-MM-DD", label: "YYYY-MM-DD (ISO)" },
                                            { fmt: "DD/MM/YYYY", label: "DD/MM/YYYY (EU)" },
                                            { fmt: "MM/DD/YYYY", label: "MM/DD/YYYY (US)" },
                                        ]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: root.date-format == fmt_item.fmt ? Theme.primary : (fmt-touch.has-hover ? Theme.surface-hover : Colors.transparent);

                                             fmt-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => {
                                                    root.update-date-format(fmt_item.fmt);
                                                }
                                            }

                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: fmt_item.label;
                                                    font-size: 11px;
                                                    font-weight: root.date-format == fmt_item.fmt ? 700 : 500;
                                                    color: root.date-format == fmt_item.fmt ? #FFFFFF : Theme.text-primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }

                            // Balance Privacy Mode Toggle Switch
                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "Balance Privacy Mode";
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Mask balances and monetary amounts across all screens";
                                        font-size: 11px;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: end;

                                    // Toggle switch
                                    Rectangle {
                                        width: 40px;
                                        border-radius: 11px;
                                        background: root.privacy-mode ? Theme.primary : Theme.border-strong;
                                        animate background { duration: 150ms; }

                                        TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                root.toggle-privacy();
                                            }
                                        }

                                        Text {
                                            text: root.privacy-mode ? "Hidden (••••)" : "Visible ($1,234)";
                                            color: root.privacy-mode ? Theme.primary : Theme.text-secondary;
                                            height: 16px;
                                            font-size: 12px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            border-radius: 8px;
                                            background: #FFFFFF;
                                            y: 3px;
                                            x: root.privacy-mode ? 21px : 3px;
                                            animate x { duration: 150ms; easing: ease-out; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // SECTION 4: CATEGORY CATALOG
        Rectangle {
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 10px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Category Catalog";
                            color: Theme.text-primary;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Organize spending & income ledger classifications (" + root.categories.length + " total)";
                            color: Theme.text-muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }

                    AppButton {
                        text: root.show-add-cat-form ? "Close Form" : "+ New Category";
                        small: true;
                        btn-color: Theme.primary;
                        clicked => {
                            if root.show-add-cat-form {
                                root.show-add-cat-form = false;
                                root.editing-cat-id = "";
                            } else {
                                root.editing-cat-id = "";
                                root.new-cat-name = "";
                                root.show-add-cat-form = true;
                            }
                        }
                    }
                }

                // Toolbar: Count pills on left + Real-time search input right-aligned
                HorizontalLayout {
                    alignment: space-between;
                    spacing: 12px;

                    // Filter Pills
                    HorizontalLayout {
                        spacing: 6px;
                        TabButton {
                            text: "All (" + root.categories.length + ")";
                            active: root.cat-catalog-filter == 0;
                            clicked => {
                                root.cat-catalog-filter = 0;
                                root.filter-categories(0);
                            }
                        }
                        TabButton {
                            text: "Expense (" + root.cat-expense-count + ")";
                            active: root.cat-catalog-filter == 1;
                            clicked => {
                                root.cat-catalog-filter = 1;
                                root.filter-categories(1);
                            }
                        }
                        TabButton {
                            text: "Income (" + root.cat-income-count + ")";
                            active: root.cat-catalog-filter == 2;
                            clicked => {
                                root.cat-catalog-filter = 2;
                                root.filter-categories(2);
                            }
                        }
                    }

                    // Real-time Search Box
                    HorizontalLayout {
                        width: 220px;
                        cat-search-box := AppInput {
                            placeholder-text: "Search categories...";
                            font-size: 11px;
                            text: root.cat-search-query;
                            edited(text) => {
                                root.cat-search-query = text;
                                root.search-categories(text);
                            }
                        }
                    }
                }

                // Inline New / Edit Category Form
                if root.show-add-cat-form: Rectangle {
                    background: #111827;
                    border-color: #1f2937;
                    border-width: 1px;
                    border-radius: 10px;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: root.editing-cat-id != "" ? "Edit Category Details" : "Create New Ledger Category";
                                font-size: 12px;
                                font-weight: 700;
                                color: #F9FAFB;
                                vertical-alignment: center;
                            }
                            if root.editing-cat-id != "": Badge {
                                text: "Editing";
                                badge-color: Theme.primary;
                            }
                        }

                        // Row 1 (Inputs): Category Name Input (horizontal-stretch: 1, min-width: 240px, height: 36px) + Type Selector (36px)
                        HorizontalLayout {
                            spacing: 12px;

                            cat-name-edit := LineEdit {
                                horizontal-stretch: 1;
                                min-width: 240px;
                                height: 36px;
                                placeholder-text: "e.g. Groceries, Freelance, Subscriptions...";
                                text <=> root.new-cat-name;
                            }

                            // Segmented Type Selector
                            Rectangle {
                                height: 36px;
                                border-radius: 6px;
                                background: #1f2937;
                                border-width: 1px;
                                border-color: #374151;

                                HorizontalLayout {
                                    padding: 3px;
                                    spacing: 3px;

                                    // Expense Segment
                                    Rectangle {
                                        width: 86px;
                                        border-radius: 4px;
                                        background: root.new-cat-type == 0 ? Theme.danger : (exp-touch.has-hover ? #374151 : Colors.transparent);

                                        exp-touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.new-cat-type = 0; }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Expense";
                                                font-size: 11px;
                                                font-weight: root.new-cat-type == 0 ? 700 : 500;
                                                color: root.new-cat-type == 0 ? #FFFFFF : #9CA3AF;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Income Segment
                                    Rectangle {
                                        width: 86px;
                                        border-radius: 4px;
                                        background: root.new-cat-type == 1 ? Theme.primary : (inc-touch.has-hover ? #374151 : Colors.transparent);

                                        inc-touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.new-cat-type = 1; }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Income";
                                                font-size: 11px;
                                                font-weight: root.new-cat-type == 1 ? 700 : 500;
                                                color: root.new-cat-type == 1 ? #FFFFFF : #9CA3AF;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Row 2: Color swatches left, action buttons right
                        HorizontalLayout {
                            alignment: space-between;

                            // Left side: Label + Swatches
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: center;

                                Text {
                                    text: "Palette Color:";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #9CA3AF;
                                    vertical-alignment: center;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    for c in [
                                        { name: "#10B981", col: #10B981 },
                                        { name: "#3B82F6", col: #3B82F6 },
                                        { name: "#8B5CF6", col: #8B5CF6 },
                                        { name: "#EC4899", col: #EC4899 },
                                        { name: "#F59E0B", col: #F59E0B },
                                        { name: "#06B6D4", col: #06B6D4 },
                                        { name: "#F43F5E", col: #F43F5E },
                                        { name: "#14B8A6", col: #14B8A6 },
                                        { name: "#6366F1", col: #6366F1 },
                                        { name: "#64748B", col: #64748B }
                                    ]: Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        border-width: root.new-cat-color == c.name ? 2px : 0px;
                                        border-color: root.new-cat-color == c.name ? #FFFFFF : Colors.transparent;
                                        background: Colors.transparent;

                                        TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                root.new-cat-color = c.name;
                                            }
                                        }

                                        Rectangle {
                                            width: root.new-cat-color == c.name ? 16px : 20px;
                                            height: root.new-cat-color == c.name ? 16px : 20px;
                                            border-radius: (self.width) / 2;
                                            background: c.col;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }

                            // Right side: Action buttons
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: center;

                                AppButton {
                                    text: "Cancel";
                                    small: false;
                                    outline: true;
                                    btn-color: #4B5563;
                                    text-color: #E5E7EB;
                                    clicked => {
                                        root.editing-cat-id = "";
                                        root.new-cat-name = "";
                                        root.show-add-cat-form = false;
                                    }
                                }

                                AppButton {
                                    text: root.editing-cat-id != "" ? "Save Changes" : "Save Category";
                                    small: false;
                                    btn-color: Theme.primary;
                                    enabled: root.new-cat-name != "";
                                    clicked => {
                                        if root.new-cat-name != "" {
                                            if root.editing-cat-id != "" {
                                                root.edit-category(root.editing-cat-id, root.new-cat-name, root.new-cat-type, root.new-cat-color);
                                            } else {
                                                root.add-category(root.new-cat-name, root.new-cat-type, root.new-cat-color);
                                            }
                                            root.new-cat-name = "";
                                            root.editing-cat-id = "";
                                            root.show-add-cat-form = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Structured Compact Data Table with Subtle Row Dividers
                Rectangle {
                    background: Theme.surface-subtle;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 8px;
                    clip: true;

                    VerticalLayout {
                        // Table Header
                        Rectangle {
                            height: 30px;
                            background: Theme.surface-hover;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;

                                // Column 1: Category Name (35% / horizontal-stretch: 3)
                                Rectangle {
                                    width: 35%;
                                    horizontal-stretch: 3;
                                    HorizontalLayout {
                                        alignment: start;
                                        Text {
                                            text: "CATEGORY NAME";
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Column 2: Type (15% / horizontal-stretch: 1)
                                Rectangle {
                                    width: 15%;
                                    horizontal-stretch: 1;
                                    HorizontalLayout {
                                        alignment: start;
                                        Text {
                                            text: "TYPE";
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Column 3: Usage / Activity (30% / horizontal-stretch: 2)
                                Rectangle {
                                    width: 30%;
                                    horizontal-stretch: 2;
                                    HorizontalLayout {
                                        alignment: start;
                                        Text {
                                            text: "USAGE / ACTIVITY";
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Column 4: Actions (20% / horizontal-stretch: 1)
                                Rectangle {
                                    width: 20%;
                                    horizontal-stretch: 1;
                                    HorizontalLayout {
                                        alignment: end;
                                        Text {
                                            text: "ACTIONS";
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Divider below header
                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }

                        // Empty State
                        if root.filtered-categories.length == 0: Rectangle {
                            height: 70px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                Text {
                                    text: "No categories match this filter";
                                    color: Theme.text-muted;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                                if root.cat-search-query != "": Text {
                                    text: "Try adjusting search query or switching spending type.";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Table Rows
                        for cat[idx] in root.filtered-categories: VerticalLayout {
                            if idx > 0: Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }

                            Rectangle {
                                height: 42px;
                                background: row-touch.has-hover ? Theme.surface-hover : Colors.transparent;

                                row-touch := TouchArea {}

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;

                                    // Column 1 (Category Name): 35% / horizontal-stretch: 3
                                    Rectangle {
                                        width: 35%;
                                        horizontal-stretch: 3;
                                        clip: true;

                                        HorizontalLayout {
                                            width: 100%;
                                            spacing: 8px;
                                            alignment: start;

                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 8px;
                                                    height: 8px;
                                                    border-radius: 4px;
                                                    background: cat.color_val;
                                                }
                                            }

                                            Text {
                                                horizontal-stretch: 1;
                                                text: cat.name;
                                                color: Theme.text-primary;
                                                font-size: 13px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    // Column 2 (Type): 15% / horizontal-stretch: 1
                                    Rectangle {
                                        width: 15%;
                                        horizontal-stretch: 1;

                                        HorizontalLayout {
                                            alignment: start;

                                            VerticalLayout {
                                                alignment: center;
                                                Badge {
                                                    text: cat.cat_type == "income" ? "Income" : "Expense";
                                                    badge-color: cat.cat_type == "income" ? Theme.primary : Theme.danger;
                                                }
                                            }
                                        }
                                    }

                                    // Column 3 (Usage / Activity): 30% / horizontal-stretch: 2
                                    Rectangle {
                                        width: 30%;
                                        horizontal-stretch: 2;

                                        HorizontalLayout {
                                            alignment: start;

                                            VerticalLayout {
                                                alignment: center;
                                                if cat.tx_count > 0: Badge {
                                                    text: cat.tx_count + (cat.tx_count == 1 ? " transaction" : " transactions");
                                                    badge-color: Theme.text-secondary;
                                                }
                                                if cat.tx_count == 0: Text {
                                                    text: "0 transactions (unused)";
                                                    color: Theme.text-muted;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // Column 4 (Actions): 20% / horizontal-stretch: 1
                                    Rectangle {
                                        width: 20%;
                                        horizontal-stretch: 1;

                                        HorizontalLayout {
                                            alignment: end;
                                            spacing: 6px;

                                            VerticalLayout {
                                                alignment: center;
                                                AppButton {
                                                    text: "Edit";
                                                    small: true;
                                                    outline: true;
                                                    btn-color: Theme.border-strong;
                                                    clicked => {
                                                        root.editing-cat-id = cat.id;
                                                        root.new-cat-name = cat.name;
                                                        root.new-cat-type = cat.cat_type == "income" ? 1 : 0;
                                                        root.new-cat-color = cat.color;
                                                        root.show-add-cat-form = true;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                if cat.tx_count == 0: AppButton {
                                                    text: "Delete";
                                                    small: true;
                                                    outline: true;
                                                    btn-color: Theme.danger;
                                                    clicked => {
                                                        root.delete-category(cat.id);
                                                    }
                                                }

                                                if cat.tx_count > 0: Rectangle {
                                                    height: 22px;
                                                    border-radius: 4px;
                                                    background: Theme.mode == 0 ? Theme.text-muted.transparentize(88%) : Theme.text-muted.transparentize(82%);
                                                    HorizontalLayout {
                                                        padding-left: 6px;
                                                        padding-right: 6px;
                                                        spacing: 4px;
                                                        alignment: center;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Image {
                                                                source: @image-url("../../assets/icons/lock.svg");
                                                                width: 10px;
                                                                height: 10px;
                                                                colorize: Theme.text-muted;
                                                            }
                                                        }
                                                        Text {
                                                            text: "In Use";
                                                            color: Theme.text-muted;
                                                            font-size: 11px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // SECTION 5: DATA BACKUP, IMPORT & PORTABILITY
        Rectangle {
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 10px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Data Backup, Import & Portability";
                            color: Theme.text-primary;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Local SQLite database storage. Export full backups or restore historical ledger records.";
                            color: Theme.text-muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    Badge {
                        text: "Offline SQLite (WAL Mode)";
                        badge-color: Theme.primary;
                    }
                }

                // Row 1: Active SQLite Database File (monospaced path + Browse File... + Reset Default)
                Rectangle {
                    background: Theme.surface-subtle;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 8px;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 12px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 3px;
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: "Active SQLite Database:";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-primary;
                            }

                            Rectangle {
                                background: Theme.surface;
                                border-color: Theme.border;
                                border-width: 1px;
                                border-radius: 4px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 4px;
                                    padding-bottom: 4px;

                                    Text {
                                        text: root.db-storage-path;
                                        font-size: 11px;
                                        font-family: "monospace";
                                        color: Theme.primary;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;

                            AppButton {
                                text: "Browse File...";
                                small: true;
                                btn-color: Theme.primary;
                                clicked => { root.select-db-file(); }
                            }

                            AppButton {
                                text: "Reset Default";
                                small: true;
                                outline: true;
                                btn-color: Theme.border-strong;
                                clicked => { root.reset-default-db(); }
                            }
                        }
                    }
                }

                // Row 2: Export Destination (monospaced path + Browse Folder + Open Folder)
                Rectangle {
                    background: Theme.surface-subtle;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 8px;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 12px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 3px;
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: "Export & Backup Destination:";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-primary;
                            }

                            Rectangle {
                                background: Theme.surface;
                                border-color: Theme.border;
                                border-width: 1px;
                                border-radius: 4px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 4px;
                                    padding-bottom: 4px;

                                    Text {
                                        text: root.export-storage-path;
                                        font-size: 11px;
                                        font-family: "monospace";
                                        color: Theme.primary;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;

                            AppButton {
                                text: "Browse Folder";
                                small: true;
                                btn-color: Theme.primary;
                                clicked => { root.select-export-folder(); }
                            }

                            AppButton {
                                text: "Open Folder";
                                small: true;
                                outline: true;
                                btn-color: Theme.border-strong;
                                clicked => { root.open-export-folder(); }
                            }
                        }
                    }
                }

                // Row 3: Google Drive Cloud Sync
                Rectangle {
                    background: Theme.surface-subtle;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 8px;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 12px;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: "Google Drive Cloud Sync";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }

                                Badge {
                                    text: root.gdrive-connected ? ("Connected (" + root.gdrive-email + ")") : "Disconnected";
                                    badge-color: root.gdrive-connected ? Theme.primary : Theme.warning;
                                }
                            }

                            Text {
                                text: root.gdrive-connected ? ("Schedule: " + (root.gdrive-frequency == "hourly" ? "Hourly" : (root.gdrive-frequency == "every_6h" ? "Every 6h" : (root.gdrive-frequency == "weekly" ? "Weekly" : (root.gdrive-frequency == "manual" ? "Manual" : "Daily")))) + " • Last backup: " + (root.gdrive-last-backup != "" ? root.gdrive-last-backup : "Never")) : "Sync encrypted ledger snapshots directly to your personal Google Drive.";
                                font-size: 11px;
                                color: Theme.text-muted;
                            }
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            if root.gdrive-connected: AppButton {
                                text: "Backup Now";
                                small: true;
                                btn-color: Theme.primary;
                                clicked => { root.gdrive-backup-now(); }
                            }

                            AppButton {
                                text: root.gdrive-connected ? "Disconnect" : "Connect Google Drive";
                                small: true;
                                outline: true;
                                btn-color: root.gdrive-connected ? Theme.danger : Theme.primary;
                                clicked => {
                                    if root.gdrive-connected {
                                        root.gdrive-disconnect();
                                    } else {
                                        root.open-gdrive-modal();
                                    }
                                }
                            }

                            if root.gdrive-connected: AppButton {
                                text: "Settings";
                                small: true;
                                outline: true;
                                btn-color: Theme.border-strong;
                                clicked => { root.open-gdrive-modal(); }
                            }
                        }
                    }
                }

                // Action Bar Separation: Safe routines on Left, Restore Ledger Backup on Far Right
                HorizontalLayout {
                    alignment: space-between;

                    // Left: Safe export routines
                    HorizontalLayout {
                        spacing: 8px;

                        AppButton {
                            text: "Export JSON Backup";
                            small: true;
                            btn-color: Theme.primary;
                            clicked => {
                                root.export-data("json");
                            }
                        }

                        AppButton {
                            text: "Export CSV Transactions";
                            small: true;
                            btn-color: Theme.primary;
                            clicked => {
                                root.export-data("csv");
                            }
                        }
                    }

                    // Right: Restore Ledger Backup (outlined warning/danger style)
                    AppButton {
                        text: "Restore Ledger Backup";
                        small: true;
                        outline: true;
                        btn-color: Theme.warning;
                        clicked => {
                            root.import-backup();
                        }
                    }
                }
            }
        }

        // DANGER ZONE (SAMPLE DEMO LEDGER)
        Rectangle {
            background: Theme.surface;
            border-color: Theme.warning;
            border-width: 1px;
            border-radius: 10px;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 3px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Text {
                                text: "Sample Demo Ledger";
                                color: Theme.text-primary;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Badge {
                                text: "Destructive Action";
                                badge-color: Theme.warning;
                            }
                        }

                        Text {
                            text: "Reset local database with rich sample transactions, recurring bills, budgets, and debts. \nWARNING: Replaces all current records.";
                            color: Theme.text-muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }

                    AppButton {
                        text: "Reset & Seed Demo";
                        small: true;
                        btn-color: Theme.warning;
                        clicked => {
                            root.reset-and-seed-demo();
                        }
                    }
                }
            }
        }

        // FOOTER BRANDING
        Rectangle {
            height: 30px;

            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 16px;
                        height: 16px;
                        source: @image-url("../../assets/icon.png");
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: "urpwallet • Personal Finance • Offline Local SQLite • Standalone Native Rust + Slint";
                    color: Theme.text-muted;
                    font-size: 11px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }
        }
    }
}
