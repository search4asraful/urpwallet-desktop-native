import { Theme } from "../theme.slint";

export component Sidebar inherits Rectangle {
    width: 215px;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;

    in-out property <int> active-tab: 0;
    in-out property <bool> privacy-mode: false;
    in property <bool> gdrive-connected: false;
    in property <bool> gdrive-loading: false;

    callback switch-tab(int);
    callback toggle-privacy();
    callback set-theme(int);
    callback gdrive-backup-now();

    VerticalLayout {
        padding: 12px;
        spacing: 4px;

        // Brand Header
        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Image {
                    width: 30px;
                    height: 30px;
                    source: @image-url("../../assets/icon.png");
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text {
                    text: "urpwallet";
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 800;
                    letter-spacing: -0.3px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Your Personal Wallet";
                    color: Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 8px; }

        // Navigation Items (36px comfortable)
        for item[index] in [
            { label: "Dashboard", tab: 0, icon: @image-url("../../assets/icons/layout-dashboard.svg") },
            { label: "Transactions", tab: 1, icon: @image-url("../../assets/icons/receipt.svg") },
            { label: "Accounts & Vaults", tab: 2, icon: @image-url("../../assets/icons/wallet.svg") },
            { label: "Budgets & Pacing", tab: 3, icon: @image-url("../../assets/icons/target.svg") },
            { label: "Recurring Bills", tab: 4, icon: @image-url("../../assets/icons/calendar.svg") },
            { label: "Debts & Loans", tab: 5, icon: @image-url("../../assets/icons/hand-coins.svg") },
            { label: "Reports", tab: 6, icon: @image-url("../../assets/icons/bar-chart.svg") },
            { label: "Settings", tab: 7, icon: @image-url("../../assets/icons/settings.svg") },
        ]: Rectangle {
            height: 36px;
            border-radius: 6px;
            background: root.active-tab == item.tab ? Theme.primary-subtle : (nav-touch.has-hover ? Theme.surface-hover : Colors.transparent);
            nav-touch := TouchArea { clicked => { root.switch-tab(item.tab); } }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: start;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: item.icon;
                        width: 16px;
                        height: 16px;
                        colorize: root.active-tab == item.tab ? Theme.primary : Theme.text-muted;
                    }
                }

                Text {
                    text: item.label;
                    color: root.active-tab == item.tab ? Theme.primary : Theme.text-primary;
                    font-weight: root.active-tab == item.tab ? 700 : 500;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { } // flex spacer

        // 1-Click Cloud Backup Button (only shown when Google Cloud Services is connected)
        if root.gdrive-connected: Rectangle {
            height: 34px;
            border-radius: 6px;
            background: backup-touch.has-hover ? Theme.primary.darker(10%) : Theme.primary;

            backup-touch := TouchArea {
                clicked => {
                    if (!root.gdrive-loading) {
                        root.gdrive-backup-now();
                    }
                }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                alignment: center;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../assets/icons/cloud.svg");
                        width: 15px;
                        height: 15px;
                        colorize: #FFFFFF;
                    }
                }
                Text {
                    text: root.gdrive-loading ? "Backing up..." : "Backup Now";
                    color: #FFFFFF;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }

        // Privacy Quick Toggle
        Rectangle {
            height: 32px;
            border-radius: 6px;
            background: root.privacy-mode ? Theme.primary-subtle : Theme.surface-hover;
            border-color: root.privacy-mode ? Theme.primary : Theme.border;
            border-width: 1px;
            TouchArea { clicked => { root.toggle-privacy(); } }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: root.privacy-mode ? @image-url("../../assets/icons/eye-off.svg") : @image-url("../../assets/icons/eye.svg");
                        width: 14px;
                        height: 14px;
                        colorize: root.privacy-mode ? Theme.primary : Theme.text-secondary;
                    }
                }

                Text {
                    text: root.privacy-mode ? "Privacy Mask (ON)" : "Privacy Mask (OFF)";
                    color: root.privacy-mode ? Theme.primary : Theme.text-secondary;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        // Theme selector buttons (Light, Dark, OLED, Emerald)
        HorizontalLayout {
            spacing: 4px;
            height: 24px;

            for th[i] in [
                { name: "Light", mode: 0 },
                { name: "Dark", mode: 1 },
                { name: "OLED", mode: 2 },
                { name: "Emerald", mode: 3 },
            ]: Rectangle {
                border-radius: 4px;
                background: Theme.mode == th.mode ? Theme.primary : Theme.surface-hover;
                TouchArea { clicked => { Theme.mode = th.mode; root.set-theme(th.mode); } }
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: th.name;
                        color: Theme.mode == th.mode ? #FFFFFF : Theme.text-muted;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
