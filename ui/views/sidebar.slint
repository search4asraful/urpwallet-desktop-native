import { Theme } from "../theme.slint";

export component Sidebar inherits Rectangle {
    in-out property <bool> collapsed: false;
    width: root.collapsed ? 64px : 215px;
    animate width { duration: 180ms; easing: ease-in-out; }
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    clip: true;

    in-out property <int> active-tab: 0;
    in-out property <bool> privacy-mode: false;
    in property <bool> gdrive-connected: false;
    in property <bool> gdrive-loading: false;

    callback switch-tab(int);
    callback toggle-privacy();
    callback set-theme(int);
    callback gdrive-backup-now();
    callback toggle-collapsed(bool);

    VerticalLayout {
        padding: root.collapsed ? 8px : 12px;
        spacing: 4px;

        // Brand Header & Collapse Toggle
        HorizontalLayout {
            spacing: root.collapsed ? 0px : 10px;
            alignment: root.collapsed ? center : space-between;

            HorizontalLayout {
                spacing: 10px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 6px;
                        background: brand-touch.has-hover && root.collapsed ? Theme.surface-hover : Colors.transparent;

                        brand-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                if root.collapsed {
                                    root.collapsed = false;
                                    root.toggle-collapsed(false);
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    width: 28px;
                                    height: 28px;
                                    source: @image-url("../../assets/icon.png");
                                }
                            }
                        }
                    }
                }

                if !root.collapsed: VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: "urpwallet";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 800;
                        letter-spacing: -0.3px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Your Personal Wallet";
                        color: Theme.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }

            // Collapse Button (when expanded)
            if !root.collapsed: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: col-touch.has-hover ? Theme.surface-hover : Colors.transparent;
                    col-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.collapsed = true;
                            root.toggle-collapsed(true);
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../assets/icons/panel-left-close.svg");
                                width: 16px;
                                height: 16px;
                                colorize: col-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                            }
                        }
                    }
                }
            }
        }

        // When collapsed, a small expand bar/button below logo
        if root.collapsed: Rectangle {
            height: 22px;
            border-radius: 4px;
            background: exp-touch.has-hover ? Theme.surface-hover : Colors.transparent;
            exp-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.collapsed = false;
                    root.toggle-collapsed(false);
                }
            }
            HorizontalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../assets/icons/panel-left-open.svg");
                    width: 14px;
                    height: 14px;
                    colorize: exp-touch.has-hover ? Theme.primary : Theme.text-muted;
                }
            }
        }

        Rectangle { height: root.collapsed ? 4px : 8px; }

        // Navigation Items
        for item[index] in [
            { label: "Dashboard", tab: 0, icon: @image-url("../../assets/icons/layout-dashboard.svg") },
            { label: "Transactions", tab: 1, icon: @image-url("../../assets/icons/receipt.svg") },
            { label: "Accounts & Vaults", tab: 2, icon: @image-url("../../assets/icons/wallet.svg") },
            { label: "Budgets & Pacing", tab: 3, icon: @image-url("../../assets/icons/target.svg") },
            { label: "Recurring Bills", tab: 4, icon: @image-url("../../assets/icons/calendar.svg") },
            { label: "Debts & Loans", tab: 5, icon: @image-url("../../assets/icons/hand-coins.svg") },
            { label: "Reports", tab: 6, icon: @image-url("../../assets/icons/bar-chart.svg") },
            { label: "Settings", tab: 7, icon: @image-url("../../assets/icons/settings.svg") },
        ]: Rectangle {
            height: 36px;
            border-radius: 6px;
            background: root.active-tab == item.tab ? Theme.primary-subtle : (nav-touch.has-hover ? Theme.surface-hover : Colors.transparent);
            border-color: root.active-tab == item.tab ? Theme.primary.transparentize(80%) : Colors.transparent;
            border-width: 1px;

            nav-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.switch-tab(item.tab); }
            }

            HorizontalLayout {
                padding-left: root.collapsed ? 0px : 10px;
                padding-right: root.collapsed ? 0px : 10px;
                alignment: root.collapsed ? center : start;
                spacing: root.collapsed ? 0px : 10px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: item.icon;
                        width: 18px;
                        height: 18px;
                        colorize: root.active-tab == item.tab ? Theme.primary : (nav-touch.has-hover ? Theme.text-primary : Theme.text-muted);
                    }
                }

                if !root.collapsed: Text {
                    text: item.label;
                    color: root.active-tab == item.tab ? Theme.primary : (nav-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                    font-weight: root.active-tab == item.tab ? 700 : 500;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        Rectangle { } // flex spacer

        // 1-Click Cloud Backup Button
        if root.gdrive-connected: Rectangle {
            height: 34px;
            border-radius: 6px;
            background: backup-touch.has-hover ? Theme.primary.darker(10%) : Theme.primary;

            backup-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    if (!root.gdrive-loading) {
                        root.gdrive-backup-now();
                    }
                }
            }

            HorizontalLayout {
                padding-left: root.collapsed ? 0px : 10px;
                padding-right: root.collapsed ? 0px : 10px;
                spacing: root.collapsed ? 0px : 8px;
                alignment: center;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../assets/icons/cloud.svg");
                        width: 16px;
                        height: 16px;
                        colorize: #FFFFFF;
                    }
                }
                if !root.collapsed: Text {
                    text: root.gdrive-loading ? "Backing up..." : "Backup Now";
                    color: #FFFFFF;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Privacy Quick Toggle
        Rectangle {
            height: 32px;
            border-radius: 6px;
            background: root.privacy-mode ? Theme.primary-subtle : Theme.surface-hover;
            border-color: root.privacy-mode ? Theme.primary : Theme.border;
            border-width: 1px;

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.toggle-privacy(); }
            }

            HorizontalLayout {
                alignment: center;
                spacing: root.collapsed ? 0px : 8px;
                padding-left: root.collapsed ? 0px : 10px;
                padding-right: root.collapsed ? 0px : 10px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: root.privacy-mode ? @image-url("../../assets/icons/eye-off.svg") : @image-url("../../assets/icons/eye.svg");
                        width: 16px;
                        height: 16px;
                        colorize: root.privacy-mode ? Theme.primary : Theme.text-secondary;
                    }
                }

                if !root.collapsed: Text {
                    text: root.privacy-mode ? "Privacy Mask (ON)" : "Privacy Mask (OFF)";
                    color: root.privacy-mode ? Theme.primary : Theme.text-secondary;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Theme selector buttons (Light, Dark, OLED, Emerald)
        if !root.collapsed: HorizontalLayout {
            spacing: 4px;
            height: 24px;

            for th[i] in [
                { name: "Light", mode: 0 },
                { name: "Dark", mode: 1 },
                { name: "OLED", mode: 2 },
                { name: "Emerald", mode: 3 },
            ]: Rectangle {
                border-radius: 4px;
                background: Theme.mode == th.mode ? Theme.primary : Theme.surface-hover;
                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { Theme.mode = th.mode; root.set-theme(th.mode); }
                }
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: th.name;
                        color: Theme.mode == th.mode ? #FFFFFF : Theme.text-muted;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // When collapsed: single compact theme cycle button
        if root.collapsed: Rectangle {
            height: 28px;
            border-radius: 4px;
            background: th-cycle-touch.has-hover ? Theme.surface-hover : Theme.surface-subtle;
            border-color: Theme.border;
            border-width: 1px;

            th-cycle-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    Theme.mode = mod(Theme.mode + 1, 4);
                    root.set-theme(Theme.mode);
                }
            }

            HorizontalLayout {
                alignment: center;
                Text {
                    text: Theme.mode == 0 ? "☀" : (Theme.mode == 1 ? "☾" : (Theme.mode == 2 ? "★" : "❖"));
                    color: Theme.primary;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
