import { Theme } from "../theme.slint";
import { BudgetItem, BudgetCategoryOption } from "../models.slint";
import { AppButton, Badge, ProgressBar, AppInput, CloseButton } from "../components.slint";
import { ScrollView } from "std-widgets.slint";

export component AddBudgetModal inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #000000.transparentize(40%);

    in property <bool> is-editing: false;
    in property <string> budget-id: "";
    in property <string> budget-name: "";
    in property <string> budget-amount: "";
    in property <string> currency-symbol: "$";
    in property <[BudgetCategoryOption]> categories: [];
    in property <int> selected-category-count: 0;

    callback close();
    callback toggle-category(string);
    callback select-all-categories(bool);
    callback submit(bool, string, string, string);

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.close(); }
    }

    Rectangle {
        width: 420px;
        height: round(min(self.preferred-height, parent.height - 40px) / 1px) * 1px;
        x: round((parent.width - self.width) / 2 / 1px) * 1px;
        y: round((parent.height - self.height) / 2 / 1px) * 1px;
        background: Theme.surface;
        border-color: Theme.border-strong;
        border-width: 1px;
        border-radius: 10px;

        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            padding: 16px;
            spacing: 8px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: root.is-editing ? "Edit Budget Limit" : "Add Budget Limit";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                CloseButton {
                    clicked => { root.close(); }
                }
            }

            Text { text: "Budget Name:"; font-size: 12px; font-weight: 600; color: Theme.text-muted; }
            input-b-name := AppInput {
                placeholder-text: "e.g. Dining & Groceries, Utilities...";
                text: root.budget-name;
            }

            Text { text: "Monthly Limit Amount:"; font-size: 12px; font-weight: 600; color: Theme.text-muted; }
            input-b-amt := AppInput {
                placeholder-text: "500.00";
                prefix-text: root.currency-symbol;
                text: root.budget-amount;
            }

            // Chosen Categories Field (Multiple Allowed)
            HorizontalLayout {
                alignment: space-between;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Categories to Track:";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                    Badge {
                        text: root.selected-category-count > 0 ? (root.selected-category-count + " Selected") : "All Categories";
                        badge-color: root.selected-category-count > 0 ? Theme.primary : Theme.info;
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    AppButton {
                        text: "All";
                        small: true;
                        btn-color: Theme.surface-hover;
                        text-color: Theme.text-secondary;
                        clicked => { root.select-all-categories(true); }
                    }
                    AppButton {
                        text: "Clear";
                        small: true;
                        btn-color: Theme.surface-hover;
                        text-color: Theme.text-secondary;
                        clicked => { root.select-all-categories(false); }
                    }
                }
            }

            Rectangle {
                height: 130px;
                background: Theme.surface-subtle;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 6px;

                ScrollView {
                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;

                        GridLayout {
                            spacing: 4px;
                            for cat[i] in root.categories: Rectangle {
                                horizontal-stretch: 1;
                                row: floor(i / 2);
                                col: mod(i, 2);
                                height: 32px;
                                border-radius: 5px;
                                background: cat.selected ? Theme.primary.transparentize(85%) : Theme.surface;
                                border-color: cat.selected ? Theme.primary : Theme.border;
                                border-width: cat.selected ? 1.5px : 1px;

                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.toggle-category(cat.id);
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                           width: 8px;
                                           height: 8px;
                                           border-radius: 4px;
                                           background: Theme.primary;
                                        }
                                    }

                                    Text {
                                        text: cat.name;
                                        font-size: 11px;
                                        font-weight: cat.selected ? 700 : 500;
                                        color: cat.selected ? Theme.primary : Theme.text-primary;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    if cat.selected: VerticalLayout {
                                        alignment: center;
                                        Image {
                                            width: 12px;
                                            height: 12px;
                                            source: @image-url("../../assets/icons/check.svg");
                                            colorize: Theme.primary;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Text {
                text: "Select categories to track specifically. If none selected, tracks all expenses.";
                font-size: 11px;
                color: Theme.text-muted;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                AppButton {
                    text: "Cancel";
                    small: true;
                    btn-color: Theme.surface-hover;
                    text-color: Theme.text-primary;
                    clicked => { root.close(); }
                }
                AppButton {
                    text: root.is-editing ? "Save Changes" : "Save Budget";
                    small: true;
                    btn-color: Theme.primary;
                    clicked => {
                        root.submit(
                            root.is-editing,
                            root.budget-id,
                            input-b-name.text,
                            input-b-amt.text
                        );
                    }
                }
            }
        }
    }
}

export component BudgetDetailModal inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #000000.transparentize(40%);

    in property <BudgetItem> detail-budget;

    callback close();
    callback open-edit-budget(string);
    callback request-delete-budget(string, string, string);

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.close(); }
    }

    Rectangle {
        width: 400px;
        height: round(min(self.preferred-height, parent.height - 40px) / 1px) * 1px;
        x: round((parent.width - self.width) / 2 / 1px) * 1px;
        y: round((parent.height - self.height) / 2 / 1px) * 1px;
        background: Theme.surface;
        border-color: Theme.border-strong;
        border-width: 1px;
        border-radius: 10px;

        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Budget Details & Pacing";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                CloseButton {
                    clicked => { root.close(); }
                }
            }

            // Progress Hero
            Rectangle {
                background: Theme.surface-subtle;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 6px;

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.detail-budget.name;
                            color: Theme.text-primary;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Badge {
                            text: root.detail-budget.is_over ? "OVER BUDGET" : "ON TRACK";
                            badge-color: root.detail-budget.is_over ? Theme.danger : Theme.primary;
                        }
                    }
                    Text {
                        text: root.detail-budget.spent + " spent of " + root.detail-budget.total;
                        color: root.detail-budget.is_over ? Theme.danger : Theme.text-primary;
                        font-size: 18px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    ProgressBar {
                        progress: root.detail-budget.percentage / 100.0;
                    }
                }
            }

            // Detail rows
            VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Tracked Categories:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    Text {
                        text: root.detail-budget.category_name != "" ? root.detail-budget.category_name : "All Categories";
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Monthly Limit:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    Text { text: root.detail-budget.total; color: Theme.text-primary; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Current Month Spent:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    Text { text: root.detail-budget.spent; color: root.detail-budget.is_over ? Theme.danger : Theme.text-primary; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Utilization Rate:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    Badge {
                        text: Math.round(root.detail-budget.percentage) + "%";
                        badge-color: root.detail-budget.is_over ? Theme.danger : Theme.primary;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Daily Safe Allowance:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    Text { text: root.detail-budget.daily_safe + " / day"; color: Theme.info; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                AppButton {
                    icon: @image-url("../../assets/icons/trash.svg");
                    text: "Delete Budget";
                    small: true;
                    btn-color: Theme.danger;
                    outline: true;
                    clicked => {
                        root.request-delete-budget(
                            root.detail-budget.id,
                            root.detail-budget.name,
                            "Monthly Limit: " + root.detail-budget.total
                        );
                    }
                }

                AppButton {
                    icon: @image-url("../../assets/icons/pen-edit.svg");
                    text: "Edit Budget";
                    small: true;
                    btn-color: Theme.primary;
                    clicked => {
                        root.close();
                        root.open-edit-budget(root.detail-budget.id);
                    }
                }
            }
        }
    }
}
