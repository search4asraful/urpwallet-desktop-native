import { Theme } from "../theme.slint";
import { AccountItem, CategoryItem, TransactionItem } from "../models.slint";
import { AppButton, Badge, AppInput, AppTextEdit, CloseButton, ModernDatePickerPopup, ModernTimePickerPopup } from "../components.slint";

export component AddTransactionModal inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #000000.transparentize(35%);

    in property <bool> is-editing: false;
    in property <string> tx-id: "";
    in-out property <int> tx-type: 0;
    in property <string> amount: "";
    in property <string> currency-symbol: "$";
    in-out property <string> account-id: "";
    in-out property <string> account-name: "";
    in-out property <string> to-account-id: "";
    in-out property <string> to-account-name: "";
    in-out property <string> category-id: "";
    in-out property <string> category-name: "";
    in property <string> payee: "";
    in property <string> note: "";
    in property <string> date: "";
    in property <string> time: "";
    in property <string> date-format: "YYYY-MM-DD";
    in-out property <int> date-year: 2026;
    in-out property <int> date-month: 10;
    in-out property <int> date-day: 1;
    in-out property <int> time-hour: 12;
    in-out property <int> time-minute: 0;
    in property <int> today-year: 2026;
    in property <int> today-month: 10;
    in property <int> today-day: 1;
    in property <int> today-hour: 12;
    in property <int> today-minute: 0;
    in property <string> modal-error: "";
    in-out property <bool> cat-show-all: false;

    in property <[AccountItem]> accounts: [];
    in property <[CategoryItem]> categories: [];
    in property <[CategoryItem]> modal-categories: [];

    property <color> active-type-color: root.tx-type == 0 ? Theme.danger : (root.tx-type == 1 ? Theme.primary : Theme.info);
    property <color> active-type-subtle: root.tx-type == 0 ? Theme.danger-subtle : (root.tx-type == 1 ? Theme.primary-subtle : Theme.info-subtle);

    callback close();
    callback cancel-clicked();
    callback tx-type-changed(int);
    callback toggle-cat-filter();
    callback submit(bool, string, int, string, string, string, string, string, string, string, string);
    callback save-clicked(bool, string, int, string, string, string, string, string, string, string, string);

    forward-focus: input-amount;

    init => {
        input-amount.focus();
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.close();
            root.cancel-clicked();
        }
    }

    Rectangle {
        width: 640px;
        height: round(min(self.preferred-height, parent.height - 40px) / 1px) * 1px;
        x: round((parent.width - self.width) / 2 / 1px) * 1px;
        y: round((parent.height - self.height) / 2 / 1px) * 1px;
        background: Theme.surface;
        border-color: Theme.border-strong;
        border-width: 1px;
        border-radius: 12px;

        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            padding: 18px;
            spacing: 12px;
            alignment: start;

            // Header
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.is-editing ?
                              (root.tx-type == 0 ? "Edit Expense" : (root.tx-type == 1 ? "Edit Income" : "Edit Transfer")) :
                              (root.tx-type == 0 ? "New Expense" : (root.tx-type == 1 ? "New Income" : "New Transfer"));
                        color: Theme.text-primary;
                        font-size: 15px;
                        font-weight: 700;
                    }
                }
                CloseButton {
                    clicked => {
                        root.close();
                        root.cancel-clicked();
                    }
                }
            }

            // Type Segment Selector
            HorizontalLayout {
                spacing: 8px;
                AppButton {
                    text: "Expense";
                    small: true;
                    btn-color: Theme.danger;
                    outline: root.tx-type != 0;
                    clicked => {
                        root.tx-type = 0;
                        root.tx-type-changed(0);
                    }
                }
                AppButton {
                    text: "Income";
                    small: true;
                    btn-color: Theme.primary;
                    outline: root.tx-type != 1;
                    clicked => {
                        root.tx-type = 1;
                        root.tx-type-changed(1);
                    }
                }
                AppButton {
                    text: "Transfer";
                    small: true;
                    btn-color: Theme.info;
                    outline: root.tx-type != 2;
                    clicked => {
                        root.tx-type = 2;
                        root.tx-type-changed(2);
                    }
                }
            }

            // Two-Column Form Body
            HorizontalLayout {
                spacing: 16px;
                alignment: start;

                // Column 1: Financial Inputs & Details
                VerticalLayout {
                    width: 294px;
                    spacing: 8px;
                    alignment: start;

                    // 1. Hero Amount Field (Full Width)
                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Amount";
                            font-size: 10px;
                            color: Theme.text-muted;
                            font-weight: 600;
                        }
                        input-amount := AppInput {
                            height: 36px;
                            font-size: 15px;
                            prefix-text: root.currency-symbol != "" ? root.currency-symbol : "$";
                            placeholder-text: "0.00";
                            text: root.amount;
                            focus-border-color: root.active-type-color;
                        }
                    }

                    // 2. Date & Time Row (Side-by-side 60% / 40%)
                    HorizontalLayout {
                        spacing: 8px;

                        // Date (60%)
                        VerticalLayout {
                            horizontal-stretch: 3;
                            spacing: 3px;
                            Text {
                                text: "Date";
                                font-size: 10px;
                                color: Theme.text-muted;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 4px;

                                input-date := AppInput {
                                    placeholder-text: root.date-format;
                                    text: root.date;
                                    focus-border-color: root.active-type-color;
                                }

                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: cal-touch.has-hover ? Theme.surface-hover : Theme.input-background;
                                    border-width: 1px;
                                    border-color: cal-touch.has-hover ? root.active-type-color : Theme.input-border;

                                    cal-touch := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            date-picker.show();
                                        }
                                    }

                                    Path {
                                        width: 14px;
                                        height: 14px;
                                        x: round((parent.width - self.width) / 2 / 1px) * 1px;
                                        y: round((parent.height - self.height) / 2 / 1px) * 1px;
                                        stroke: cal-touch.has-hover ? root.active-type-color : Theme.text-muted;
                                        stroke-width: 1.5px;

                                        MoveTo { x: 1; y: 3; }
                                        LineTo { x: 13; y: 3; }
                                        LineTo { x: 13; y: 13; }
                                        LineTo { x: 1; y: 13; }
                                        Close {}
                                        MoveTo { x: 1; y: 6; }
                                        LineTo { x: 13; y: 6; }
                                        MoveTo { x: 4; y: 1; }
                                        LineTo { x: 4; y: 4; }
                                        MoveTo { x: 10; y: 1; }
                                        LineTo { x: 10; y: 4; }
                                    }

                                    date-picker := ModernDatePickerPopup {
                                        x: -130px;
                                        y: parent.height + 6px;
                                        accent-color: root.active-type-color;
                                        selected-year: root.date-year;
                                        selected-month: root.date-month;
                                        selected-day: root.date-day;
                                        today-year: root.today-year;
                                        today-month: root.today-month;
                                        today-day: root.today-day;
                                        accepted(y, m, d) => {
                                            root.date-year = y;
                                            root.date-month = m;
                                            root.date-day = d;
                                            if root.date-format == "DD/MM/YYYY" {
                                                input-date.text = (d < 10 ? "0" : "") + d + "/" + (m < 10 ? "0" : "") + m + "/" + y;
                                            } else if root.date-format == "MM/DD/YYYY" {
                                                input-date.text = (m < 10 ? "0" : "") + m + "/" + (d < 10 ? "0" : "") + d + "/" + y;
                                            } else {
                                                input-date.text = "" + y + "-" + (m < 10 ? "0" : "") + m + "-" + (d < 10 ? "0" : "") + d;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Time (40%)
                        VerticalLayout {
                            horizontal-stretch: 2;
                            spacing: 3px;
                            Text {
                                text: "Time";
                                font-size: 10px;
                                color: Theme.text-muted;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 4px;

                                input-time := AppInput {
                                    placeholder-text: "HH:MM";
                                    text: root.time;
                                    focus-border-color: root.active-type-color;
                                }

                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: time-touch.has-hover ? Theme.surface-hover : Theme.input-background;
                                    border-width: 1px;
                                    border-color: time-touch.has-hover ? root.active-type-color : Theme.input-border;

                                    time-touch := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            time-picker.show();
                                        }
                                    }

                                    // Vector Clock Icon
                                    Rectangle {
                                        width: 14px;
                                        height: 14px;
                                        x: round((parent.width - self.width) / 2 / 1px) * 1px;
                                        y: round((parent.height - self.height) / 2 / 1px) * 1px;
                                        border-radius: 7px;
                                        border-width: 1.5px;
                                        border-color: time-touch.has-hover ? root.active-type-color : Theme.text-muted;

                                        Path {
                                            width: 14px;
                                            height: 14px;
                                            stroke: time-touch.has-hover ? root.active-type-color : Theme.text-muted;
                                            stroke-width: 1.5px;

                                            MoveTo { x: 7; y: 3.5; }
                                            LineTo { x: 7; y: 7; }
                                            LineTo { x: 9.5; y: 7; }
                                        }

                                        Rectangle {
                                            x: 6px;
                                            y: 6px;
                                            width: 2px;
                                            height: 2px;
                                            border-radius: 1px;
                                            background: time-touch.has-hover ? root.active-type-color : Theme.text-muted;
                                        }
                                    }

                                    time-picker := ModernTimePickerPopup {
                                        x: -218px;
                                        y: parent.height + 6px;
                                        accent-color: root.active-type-color;
                                        selected-hour: root.time-hour;
                                        selected-minute: root.time-minute;
                                        today-hour: root.today-hour;
                                        today-minute: root.today-minute;
                                        accepted(h, min) => {
                                            root.time-hour = h;
                                            root.time-minute = min;
                                            input-time.text = "" + (h < 10 ? "0" : "") + h + ":" + (min < 10 ? "0" : "") + min;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 3. Payee / Merchant
                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Payee / Merchant";
                            font-size: 10px;
                            color: Theme.text-muted;
                            font-weight: 600;
                        }
                        input-payee := AppInput {
                            placeholder-text: "Merchant, store, or employer...";
                            text: root.payee;
                            focus-border-color: root.active-type-color;
                        }
                    }

                    // 4. Note / Description (Expanded Multi-line TextEdit)
                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Note / Description";
                            font-size: 10px;
                            color: Theme.text-muted;
                            font-weight: 600;
                        }
                        input-note := AppTextEdit {
                            height: 72px;
                            placeholder-text: "Optional note or description...";
                            text: root.note;
                            focus-border-color: root.active-type-color;
                        }
                    }

                    if root.modal-error != "": Text {
                        text: root.modal-error;
                        color: Theme.danger;
                        font-size: 10px;
                        font-weight: 600;
                    }
                }

                // Column 2: Account & Category Selectors
                VerticalLayout {
                    width: 294px;
                    spacing: 10px;
                    alignment: start;

                    // 1. Source Account Selector
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Source Account"; font-size: 10px; color: Theme.text-muted; font-weight: 600; }
                            if root.account-name != "": Text {
                                text: root.account-name;
                                font-size: 10px;
                                color: root.active-type-color;
                                font-weight: 700;
                            }
                        }
                        GridLayout {
                            spacing: 4px;
                            for acc[i] in root.accounts: Rectangle {
                                horizontal-stretch: 1;
                                row: floor(i / 2);
                                col: mod(i, 2);
                                height: 26px;
                                border-radius: 4px;
                                background: acc.id == root.account-id ? root.active-type-color : Theme.surface-subtle;
                                border-color: acc.id == root.account-id ? root.active-type-color : Theme.border;
                                border-width: 1px;

                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.account-id = acc.id;
                                        root.account-name = acc.name;
                                    }
                                }
                                VerticalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;
                                    Text {
                                        text: acc.name;
                                        font-size: 10px;
                                        color: acc.id == root.account-id ? #ffffff : Theme.text-primary;
                                        font-weight: 600;
                                        overflow: elide;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            if root.accounts.length == 1: Rectangle {
                                row: 0;
                                col: 1;
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    // 2A. Destination Account (If Transfer)
                    if root.tx-type == 2: VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Destination Account"; font-size: 10px; color: Theme.text-muted; font-weight: 600; }
                            if root.to-account-name != "": Text {
                                text: root.to-account-name;
                                font-size: 10px;
                                color: Theme.info;
                                font-weight: 700;
                            }
                        }
                        GridLayout {
                            spacing: 4px;
                            for acc[i] in root.accounts: Rectangle {
                                horizontal-stretch: 1;
                                row: floor(i / 2);
                                col: mod(i, 2);
                                height: 26px;
                                border-radius: 4px;
                                background: acc.id == root.to-account-id ? Theme.info : Theme.surface-subtle;
                                border-color: acc.id == root.to-account-id ? Theme.info : Theme.border;
                                border-width: 1px;

                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.to-account-id = acc.id;
                                        root.to-account-name = acc.name;
                                    }
                                }
                                VerticalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;
                                    Text {
                                        text: acc.name;
                                        font-size: 10px;
                                        color: acc.id == root.to-account-id ? #ffffff : Theme.text-primary;
                                        font-weight: 600;
                                        overflow: elide;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            if root.accounts.length == 1: Rectangle {
                                row: 0;
                                col: 1;
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    // 2B. Category Grid (If Expense or Income)
                    if root.tx-type != 2: VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Category"; font-size: 10px; color: Theme.text-muted; font-weight: 600; }
                            Rectangle {
                                height: 18px;
                                border-radius: 4px;
                                background: Theme.surface-subtle;
                                border-color: Theme.border;
                                border-width: 1px;
                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.toggle-cat-filter(); }
                                }
                                VerticalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;
                                    Text {
                                        text: root.cat-show-all ? "All Types ▾" : (root.tx-type == 0 ? "Expense ▾" : "Income ▾");
                                        font-size: 10px;
                                        color: Theme.text-secondary;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        GridLayout {
                            spacing: 4px;
                            for cat[i] in root.modal-categories: Rectangle {
                                horizontal-stretch: 1;
                                row: floor(i / 2);
                                col: mod(i, 2);
                                height: 26px;
                                border-radius: 4px;
                                background: cat.id == root.category-id ? root.active-type-subtle : Theme.surface-subtle;
                                border-color: cat.id == root.category-id ? root.active-type-color : Theme.border;
                                border-width: cat.id == root.category-id ? 1.5px : 1px;

                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.category-id = cat.id;
                                        root.category-name = cat.name;
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 5px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: cat.cat_type == "income" ? Theme.primary : Theme.accent;
                                        }
                                    }
                                    Text {
                                        text: cat.name;
                                        font-size: 10px;
                                        color: cat.id == root.category-id ? root.active-type-color : Theme.text-primary;
                                        font-weight: cat.id == root.category-id ? 700 : 500;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            if root.modal-categories.length == 1: Rectangle {
                                row: 0;
                                col: 1;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }

            // Modal Footer
            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                AppButton {
                    text: "Cancel";
                    small: true;
                    btn-color: Theme.surface-hover;
                    text-color: Theme.text-primary;
                    clicked => {
                        root.close();
                        root.cancel-clicked();
                    }
                }

                AppButton {
                    text: root.is-editing ? "Save Changes" : "Save Transaction";
                    small: true;
                    btn-color: root.active-type-color;
                    clicked => {
                        root.submit(
                            root.is-editing,
                            root.tx-id,
                            root.tx-type,
                            input-amount.text,
                            root.account-id,
                            root.to-account-id,
                            root.category-id,
                            input-payee.text,
                            input-note.text,
                            input-date.text,
                            input-time.text
                        );
                        root.save-clicked(
                            root.is-editing,
                            root.tx-id,
                            root.tx-type,
                            input-amount.text,
                            root.account-id,
                            root.to-account-id,
                            root.category-id,
                            input-payee.text,
                            input-note.text,
                            input-date.text,
                            input-time.text
                        );
                    }
                }
            }
        }
    }
}

export component TransactionDetailModal inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #000000.transparentize(40%);

    in property <TransactionItem> detail-tx;

    callback close();
    callback open-edit-tx(string);
    callback delete-transaction(string);

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.close(); }
    }

    Rectangle {
        width: 380px;
        height: round(min(self.preferred-height, parent.height - 40px) / 1px) * 1px;
        x: round((parent.width - self.width) / 2 / 1px) * 1px;
        y: round((parent.height - self.height) / 2 / 1px) * 1px;
        background: Theme.surface;
        border-color: Theme.border-strong;
        border-width: 1px;
        border-radius: 10px;

        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Transaction Details";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                CloseButton {
                    clicked => { root.close(); }
                }
            }

            // Amount Hero
            Rectangle {
                background: Theme.surface-subtle;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 6px;
                height: 52px;

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.detail-tx.amount;
                        color: root.detail-tx.is_transfer ? Theme.info : (root.detail-tx.is_income ? Theme.primary : Theme.danger);
                        font-size: 20px;
                        font-weight: 900;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.detail-tx.title;
                        color: Theme.text-secondary;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                }
            }

            // Details Rows
            VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Account:"; color: Theme.text-muted; font-size: 11px; }
                    Text {
                        text: root.detail-tx.is_transfer ? (root.detail-tx.account_name + " ➔ " + root.detail-tx.to_account_name) : root.detail-tx.account_name;
                        color: Theme.text-primary;
                        font-size: 11px;
                        font-weight: 700;
                    }
                }

                if root.detail-tx.category_name != "": HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Category:"; color: Theme.text-muted; font-size: 11px; }
                    Badge {
                        text: root.detail-tx.category_name;
                        badge-color: Theme.accent;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Date & Time:"; color: Theme.text-muted; font-size: 11px; }
                    Text { text: root.detail-tx.date + " " + root.detail-tx.time; color: Theme.text-primary; font-size: 11px; font-weight: 600; }
                }

                if root.detail-tx.note != "": HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Note:"; color: Theme.text-muted; font-size: 11px; }
                    Text { text: root.detail-tx.note; color: Theme.text-secondary; font-size: 11px; }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Status:"; color: Theme.text-muted; font-size: 11px; }
                    Badge { text: root.detail-tx.status; badge-color: Theme.primary; }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                AppButton {
                    text: "Delete Record";
                    small: true;
                    btn-color: Theme.danger;
                    outline: true;
                    clicked => {
                        root.delete-transaction(root.detail-tx.id);
                        root.close();
                    }
                }

                AppButton {
                    text: "Edit Transaction";
                    small: true;
                    btn-color: Theme.primary;
                    clicked => {
                        root.open-edit-tx(root.detail-tx.id);
                    }
                }
            }
        }
    }
}