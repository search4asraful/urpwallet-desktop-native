import { Theme } from "../theme.slint";
import { BillItem } from "../models.slint";
import { AppButton, Badge, AppInput, CloseButton } from "../components.slint";

export component AddBillModal inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #000000.transparentize(40%);

    in property <bool> is-editing: false;
    in property <string> bill-id: "";
    in property <string> bill-name: "";
    in property <string> bill-amount: "";
    in property <string> bill-account-id: "";
    in property <string> bill-category-id: "";
    in property <string> bill-payee: "";
    in property <string> bill-next-date: "";
    in property <string> currency-symbol: "$";

    in-out property <int> selected-freq: 2; // 0: Daily, 1: Weekly, 2: Monthly, 3: Yearly

    callback close();
    callback submit(bool, string, string, string, string, string, string, int, string);

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.close(); }
    }

    Rectangle {
        width: 400px;
        height: round(min(self.preferred-height, parent.height - 40px) / 1px) * 1px;
        x: round((parent.width - self.width) / 2 / 1px) * 1px;
        y: round((parent.height - self.height) / 2 / 1px) * 1px;
        background: Theme.surface;
        border-color: Theme.border-strong;
        border-width: 1px;
        border-radius: 12px;

        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            padding: 18px;
            spacing: 8px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: root.is-editing ? "Edit Recurring Bill & Subscription" : "Create Recurring Bill & Subscription";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                CloseButton {
                    clicked => { root.close(); }
                }
            }

            Text { text: "Bill or Subscription Name:"; font-size: 12px; font-weight: 600; color: Theme.text-muted; }
            input-bill-name := AppInput {
                placeholder-text: "e.g. Netflix, Spotify, Rent, AWS, Gym...";
                text: root.bill-name;
            }

            Text { text: "Recurring Amount:"; font-size: 12px; font-weight: 600; color: Theme.text-muted; }
            input-bill-amt := AppInput {
                placeholder-text: "19.99";
                prefix-text: root.currency-symbol;
                text: root.bill-amount;
            }

            Text { text: "Frequency / Billing Cycle:"; font-size: 12px; font-weight: 600; color: Theme.text-muted; }
            HorizontalLayout {
                spacing: 6px;
                for freq in [
                    { idx: 2, label: "Monthly" },
                    { idx: 3, label: "Yearly" },
                    { idx: 1, label: "Weekly" },
                    { idx: 0, label: "Daily" }
                ]: Rectangle {
                    height: 30px;
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    background: root.selected-freq == freq.idx ? Theme.primary : Theme.surface-subtle;
                    border-color: root.selected-freq == freq.idx ? Theme.primary : Theme.border;
                    border-width: 1px;
                    TouchArea {
                        clicked => { root.selected-freq = freq.idx; }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: freq.label;
                            font-size: 11px;
                            font-weight: 600;
                            color: root.selected-freq == freq.idx ? #FFFFFF : Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Text { text: "Payee / Provider (Optional):"; font-size: 12px; font-weight: 600; color: Theme.text-muted; }
            input-bill-payee := AppInput {
                placeholder-text: "e.g. Netflix Inc, Landlord, Utility Co...";
                text: root.bill-payee;
            }

            Text { text: "Next Due Date (YYYY-MM-DD):"; font-size: 12px; font-weight: 600; color: Theme.text-muted; }
            input-bill-date := AppInput {
                placeholder-text: "2026-11-01 (leave blank for today)";
                text: root.bill-next-date;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                AppButton {
                    text: "Cancel";
                    small: true;
                    btn-color: Theme.surface-hover;
                    text-color: Theme.text-primary;
                    clicked => { root.close(); }
                }
                AppButton {
                    text: root.is-editing ? "Save Changes" : "Create Bill & Subscription";
                    small: true;
                    btn-color: Theme.primary;
                    clicked => {
                        root.submit(
                            root.is-editing,
                            root.bill-id,
                            input-bill-name.text,
                            input-bill-amt.text,
                            root.bill-account-id,
                            root.bill-category-id,
                            input-bill-payee.text,
                            root.selected-freq,
                            input-bill-date.text
                        );
                    }
                }
            }
        }
    }
}

export component BillDetailModal inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #000000.transparentize(40%);

    in property <BillItem> detail-bill;

    callback close();
    callback request-delete-bill(string, string, string);
    callback open-edit-bill(string);
    callback execute-bill-payment(string);

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.close(); }
    }

    Rectangle {
        width: 380px;
        height: round(min(self.preferred-height, parent.height - 40px) / 1px) * 1px;
        x: round((parent.width - self.width) / 2 / 1px) * 1px;
        y: round((parent.height - self.height) / 2 / 1px) * 1px;
        background: Theme.surface;
        border-color: Theme.border-strong;
        border-width: 1px;
        border-radius: 10px;

        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Recurring Bill Details";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                CloseButton {
                    clicked => { root.close(); }
                }
            }

            // Bill Hero
            Rectangle {
                background: Theme.surface-subtle;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 6px;
                height: 56px;

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.detail-bill.amount;
                        color: root.detail-bill.is_expense ? Theme.danger : Theme.primary;
                        font-size: 22px;
                        font-weight: 900;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.detail-bill.name;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Detail rows
            VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Payee / Provider:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    Text { text: root.detail-bill.payee != "" ? root.detail-bill.payee : "None"; color: Theme.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Frequency:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    Badge {
                        text: root.detail-bill.frequency;
                        badge-color: Theme.info;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Next Due Date:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    Text { text: root.detail-bill.due_date; color: Theme.warning; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Debiting Account:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    Badge {
                        text: root.detail-bill.account_name;
                        badge-color: Theme.primary;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                AppButton {
                    icon: @image-url("../../assets/icons/trash.svg");
                    text: "Delete Bill";
                    small: true;
                    btn-color: Theme.danger;
                    outline: true;
                    clicked => {
                        root.request-delete-bill(
                            root.detail-bill.id,
                            root.detail-bill.name,
                            "Amount: " + root.detail-bill.amount + " (" + root.detail-bill.frequency + ") • Next: " + root.detail-bill.due_date
                        );
                    }
                }

                AppButton {
                    icon: @image-url("../../assets/icons/pen-edit.svg");
                    text: "Edit Bill";
                    small: true;
                    outline: true;
                    btn-color: Theme.info;
                    clicked => {
                        root.close();
                        root.open-edit-bill(root.detail-bill.id);
                    }
                }

                AppButton {
                    icon: @image-url("../../assets/icons/paying-cash.svg");
                    text: "Pay Now";
                    small: true;
                    btn-color: Theme.primary;
                    clicked => {
                        root.execute-bill-payment(root.detail-bill.id);
                        root.close();
                    }
                }
            }
        }
    }
}
