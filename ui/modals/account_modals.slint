import { Theme } from "../theme.slint";
import { AccountItem } from "../models.slint";
import { AppButton, Badge, AppInput, CurrencySelector, CloseButton } from "../components.slint";

export component AddAccountModal inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #000000.transparentize(40%);

    in property <bool> is-editing: false;
    in property <string> acc-id: "";
    in property <string> acc-name: "";
    in-out property <int> acc-type: 0;
    in property <string> balance: "";
    in-out property <string> currency: "BDT";

    callback close();
    callback submit(bool, string, string, int, string, string, string);

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.close(); }
    }

    Rectangle {
        width: 380px;
        height: round(min(self.preferred-height, parent.height - 40px) / 1px) * 1px;
        x: round((parent.width - self.width) / 2 / 1px) * 1px;
        y: round((parent.height - self.height) / 2 / 1px) * 1px;
        background: Theme.surface;
        border-color: Theme.border-strong;
        border-width: 1px;
        border-radius: 10px;

        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            padding: 16px;
            spacing: 8px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: root.is-editing ? "Edit Account" : "Create New Account";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                CloseButton {
                    clicked => { root.close(); }
                }
            }

            Text { text: "Account Name:"; font-size: 12px; font-weight: 600; color: Theme.text-muted; }
            input-acc-name := AppInput {
                placeholder-text: "e.g. Chase Checking, Vault...";
                text: root.acc-name;
            }

            Text { text: "Account Type:"; font-size: 12px; font-weight: 600; color: Theme.text-muted; }
            HorizontalLayout {
                spacing: 4px;
                AppButton {
                    text: "Bank";
                    small: true;
                    outline: root.acc-type != 0;
                    clicked => { root.acc-type = 0; }
                }
                AppButton {
                    text: "Cash";
                    small: true;
                    outline: root.acc-type != 1;
                    clicked => { root.acc-type = 1; }
                }
                AppButton {
                    text: "Savings";
                    small: true;
                    outline: root.acc-type != 2;
                    clicked => { root.acc-type = 2; }
                }
                AppButton {
                    text: "Credit";
                    small: true;
                    outline: root.acc-type != 3;
                    clicked => { root.acc-type = 3; }
                }
                AppButton {
                    text: "Loan";
                    small: true;
                    outline: root.acc-type != 5;
                    clicked => { root.acc-type = 5; }
                }
            }

            Text { text: "Balance:"; font-size: 12px; font-weight: 600; color: Theme.text-muted; }
            input-acc-bal := AppInput {
                placeholder-text: "0.00";
                text: root.balance;
            }

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Currency:";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                Badge {
                    text: root.currency;
                    badge-color: Theme.primary;
                }
            }
            CurrencySelector {
                selected-currency <=> root.currency;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                AppButton {
                    text: "Cancel";
                    small: true;
                    btn-color: Theme.surface-hover;
                    text-color: Theme.text-primary;
                    clicked => { root.close(); }
                }
                AppButton {
                    text: root.is-editing ? "Save Changes" : "Create Account";
                    small: true;
                    btn-color: Theme.primary;
                    clicked => {
                        root.submit(
                            root.is-editing,
                            root.acc-id,
                            input-acc-name.text,
                            root.acc-type,
                            input-acc-bal.text,
                            root.currency,
                            "#3B82F6"
                        );
                    }
                }
            }
        }
    }
}

export component AccountDetailModal inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #000000.transparentize(40%);

    in property <AccountItem> detail-acc;

    callback close();
    callback open-edit-account(string);
    callback delete-account(string);

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.close(); }
    }

    Rectangle {
        width: 380px;
        height: round(min(self.preferred-height, parent.height - 40px) / 1px) * 1px;
        x: round((parent.width - self.width) / 2 / 1px) * 1px;
        y: round((parent.height - self.height) / 2 / 1px) * 1px;
        background: Theme.surface;
        border-color: Theme.border-strong;
        border-width: 1px;
        border-radius: 10px;

        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Account Details";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                CloseButton {
                    clicked => { root.close(); }
                }
            }

            // Balance Hero
            Rectangle {
                background: Theme.surface-subtle;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 6px;
                height: 56px;

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.detail-acc.balance;
                        color: root.detail-acc.is_liability ? Theme.danger : Theme.primary;
                        font-size: 22px;
                        font-weight: 900;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.detail-acc.name;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Detail rows
            VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Classification:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    Badge {
                        text: root.detail-acc.is_liability ? "Liability / Debt" : "Asset / Capital";
                        badge-color: root.detail-acc.is_liability ? Theme.danger : Theme.primary;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Account Type:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    Badge {
                        text: root.detail-acc.acc_type;
                        badge-color: Theme.info;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Currency:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    Text { text: root.detail-acc.currency; color: Theme.text-primary; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Account ID:"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                    Text { text: root.detail-acc.id; color: Theme.text-secondary; font-size: 11px; font-family: "monospace"; vertical-alignment: center; }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                AppButton {
                    icon: @image-url("../../assets/icons/trash.svg");
                    text: "Delete Account";
                    small: true;
                    btn-color: Theme.danger;
                    outline: true;
                    clicked => {
                        root.delete-account(root.detail-acc.id);
                        root.close();
                    }
                }

                AppButton {
                    icon: @image-url("../../assets/icons/pen-edit.svg");
                    text: "Edit Account";
                    small: true;
                    btn-color: Theme.primary;
                    clicked => {
                        root.close();
                        root.open-edit-account(root.detail-acc.id);
                    }
                }
            }
        }
    }
}
